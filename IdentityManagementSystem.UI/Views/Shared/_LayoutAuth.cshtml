<!DOCTYPE html>
<html dir="rtl" data-header-styles="light" data-menu-styles="light" data-nav-layout="vertical" data-theme-mode="light" data-toggled="close" data-vertical-style="overlay" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServicePMO</title>

    <!-- Favicon -->
    <link rel="icon" href="~/assets/images/brand-logos/favicon.ico" type="image/x-icon" />

    <!-- Main Theme Js -->
    <script src="~/assets/js/authentication-main.js"></script>
    <script>
        (function () {
            var html = document.querySelector('html');
            html.setAttribute('data-theme-mode', 'light');
            html.setAttribute('data-header-styles', 'light');
            html.setAttribute('data-menu-styles', 'light');
        })();
    </script>

    <!-- Bootstrap RTL -->
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" id="style" rel="stylesheet" />

    <!-- Vazir Font -->
    <link href="~/assets/css/vazir-font.css" rel="stylesheet" />

    <!-- Main Styles -->
    <link href="~/assets/css/styles.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/assets/css/icons.css" rel="stylesheet" />

    <!-- Toastr -->
    <link href="~/lib/bootstrap/dist/css/toastr.min.css" rel="stylesheet" />

    <!-- Toastify CSS -->
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />

    <!-- Site Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="authentication-background">

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- jQuery -->
    <script src="~/assets/js/jquery.min.js"></script>

    <!-- Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-ajax-unobtrusive/dist/jquery.unobtrusive-ajax.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr -->
    <script src="~/lib/bootstrap/dist/js/toastr.min.js"></script>

    <!-- Authentication scripts -->
    <script src="~/assets/js/two-step-verification.js"></script>
    <script src="~/assets/js/show-password.js"></script>
    
    <!-- Toastify JS -->
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>

    <!-- Toast JS -->
    <script src="~/assets/js/toasts.js"> </script>

    <script>
        window.showToast = function (message, type = "info") {
            let backgroundColor = "#5477f5"; //‌ آبی

            if (type === "success") backgroundColor = "#28a745";
            if (type === "error") backgroundColor = "#dc3545";
            if (type === "warning") backgroundColor = "#ffc107";

            Toastify({
                text: message,
                duration: 4000,
                gravity: "top",
                position: "left",
                style: {
                    background: backgroundColor,
                },
                close: true
            }).showToast();
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>