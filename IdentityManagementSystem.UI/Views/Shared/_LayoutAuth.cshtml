<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServicePMO</title>

    <!-- Favicon -->
    <link rel="icon" href="~/assets/images/brand-logos/favicon.ico" type="image/x-icon" />

    <!-- Bootstrap RTL -->
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- Main Styles -->
    <link href="~/assets/css/styles.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/assets/css/icons.css" rel="stylesheet" />

    <!-- Toastify CSS -->
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <!-- اگر فایل‌ها رو مستقیم تو wwwroot گذاشتی، مسیر رو مطابق خودش تنظیم کن -->
    <!-- Site Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="authentication-background">

    @RenderBody()

    <!-- jQuery -->
    <script src="~/assets/js/jquery.min.js"></script>

    <!-- Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Toastify JS -->
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>

    <!-- Authentication scripts -->
    <script src="~/assets/js/authentication-main.js"></script>
    <script src="~/assets/js/show-password.js"></script>
    <script src="~/assets/js/animation-auth.js"></script>

    <script>
        // تابع کمکی برای استفاده راحت‌تر از Toastify
        window.showToast = function (message, type = "info") {
            let backgroundColor = "#5477f5"; // پیش‌فرض آبی

            if (type === "success") backgroundColor = "#28a745";
            if (type === "error") backgroundColor = "#dc3545";
            if (type === "warning") backgroundColor = "#ffc107";

            Toastify({
                text: message,
                duration: 4000,
                gravity: "top",
                position: "left",
                style: {
                    background: backgroundColor,
                },
                close: true
            }).showToast();
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>