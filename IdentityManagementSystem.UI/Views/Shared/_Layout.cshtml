<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceUIPMO</title>

    <!-- Favicon -->
    <link rel="icon" href="~/assets/images/brand-logos/logo-pmo.png" type="image/x-icon" />

    <!-- Bootstrap RTL -->
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- Main Styles -->
    <link href="~/assets/css/styles.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/assets/css/icons.css" rel="stylesheet" />

    <!-- Toastr -->
    <link href="~/lib/bootstrap/dist/css/toastr.min.css" rel="stylesheet" />

    <!-- Site Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="app sidebar-mini rtl">

    <!-- GLOBAL LOADER -->
    <div id="global-loader">
        <img src="~/assets/images/loader.svg" class="loader-img" alt="Loader" onerror="this.parentElement.style.display='none'">
    </div>

    <!-- PAGE -->
    <div class="page">
        <div class="page-main">

            <!-- HEADER -->
            <header class="app-header">
                <div class="header-container d-flex align-items-center justify-content-between px-3 py-2">
                    <div class="header-left">
                        <a class="logo-horizontal" asp-controller="Cartable" asp-action="Index">
                            <img src="~/assets/images/brand-logos/logo-pmo.png" alt="Logo" style="height: 40px;"
                                 onerror="this.src='~/assets/images/brand-logos/logo-pmo.png'">
                        </a>
                    </div>

                    <div class="header-right d-flex align-items-center gap-3">
                        @{
                            var userRole = Context.Session.GetString("UserRole");
                            var userRoleId = Context.Session.GetString("UserRoleId");
                            var isAdmin = (userRole == "ادمین" || userRoleId == "3");
                        }
                        @if (isAdmin)
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Home" asp-action="Users">
                                <i class="ri-team-line"></i>
                                <span class="d-none d-md-inline">مدیریت کاربران</span>
                            </a>
                        }

                        <a href="javascript:void(0)" id="fullScreenBtn" class="text-dark fs-18" title="تمام صفحه">
                            <i class="ri-fullscreen-line" id="fullScreenIcon"></i>
                        </a>

                        <div class="dropdown">
                            <a href="javascript:void(0)" class="d-flex align-items-center" data-bs-toggle="dropdown">
                                <img src="~/assets/images/faces/9.jpg" alt="profile" class="rounded-circle"
                                     style="width:36px;height:36px;object-fit:cover;"
                                     onerror="this.src='https://via.placeholder.com/36'">
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="EditProfile">
                                        <i class="ri-user-line me-2"></i> پروفایل
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form id="logout-form" asp-controller="Home" asp-action="Logout" method="post" class="d-none">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="document.getElementById('logout-form').submit();">
                                        <i class="ri-logout-box-r-line me-2"></i> خروج
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </header>

            <!-- MAIN CONTENT -->
            <div class="main-content app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>

            <!-- FOOTER -->
            <footer class="footer mt-auto py-3 border-top">
                <div class="container-fluid">
                    <div class="text-center small text-muted">
                        © <span id="year"></span>
                        <span class="fw-semibold">اداره کل بنادر و دریانوردی هرمزگان</span> —
                        طراحی و توسعه توسط
                        <span class="text-primary fw-semibold">تیم فناوری اطلاعات</span>
                    </div>
                </div>
            </footer>

        </div>
    </div>

    <!-- ==================== SCRIPTS ==================== -->
    <!-- jQuery اول از همه -->
    <script src="~/assets/js/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr (باید قبل از کدهای خودمون لود بشه) -->
    <script src="~/lib/bootstrap/dist/js/toastr.min.js"></script>

    <!-- اگر flatpickr لازم داری (برای جلوگیری از خطای custom.js) -->
    <!-- <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script> -->

    <script>
        // مخفی کردن لودر به محض آماده شدن صفحه
        (function () {
            const loader = document.getElementById('global-loader');
            if (loader) {
                loader.style.display = 'none';
            }
        })();

        $(document).ready(function () {
            // سال شمسی
            const yearEl = document.getElementById("year");
            if (yearEl) {
                yearEl.textContent = new Date().toLocaleDateString("fa-IR", { year: "numeric" });
            }

            // تنظیمات Toastr
            if (typeof toastr !== 'undefined') {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: "toast-top-left",
                    timeOut: 5000,
                    rtl: true
                };
            }

            // Fullscreen
            const fullScreenBtn = document.getElementById('fullScreenBtn');
            const fullScreenIcon = document.getElementById('fullScreenIcon');
            if (fullScreenBtn && fullScreenIcon) {
                fullScreenBtn.addEventListener('click', function () {
                    if (!document.fullscreenElement) {
                        document.documentElement.requestFullscreen()
                            .then(() => fullScreenIcon.className = 'ri-fullscreen-exit-line')
                            .catch(console.error);
                    } else {
                        document.exitFullscreen()
                            .then(() => fullScreenIcon.className = 'ri-fullscreen-line');
                    }
                });
            }
        });
    </script>

    @* اسکریپت‌های صفحه *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>