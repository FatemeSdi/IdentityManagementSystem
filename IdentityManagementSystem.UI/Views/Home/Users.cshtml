@using IdentityManagementSystem.UI.Controllers
@model IEnumerable<IdentityManagementSystem.UI.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "کاربران";
    Layout = "_Layout";
}

<div class="ims-page-header">
    <div>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Cartable" asp-action="Index">کارتابل</a></li>
                <li aria-current="page" class="breadcrumb-item active">مدیریت کاربران</li>
            </ol>
        </nav>
    </div>
    <button id="AddUser" type="button" class="btn btn-primary btn-wave">
        <i class="ti ti-user-plus me-1"></i> افزودن کاربر
    </button>
</div>

@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="card custom-card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="card-title mb-0">
            <i class="ti ti-users me-1"></i>
            لیست کاربران
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-primary-transparent fs-12">@(Model?.Count() ?? 0) کاربر</span>
        </div>
    </div>
    <div class="card-body">
        <div class="input-group ims-table-search mb-3">
            <span class="input-group-text"><i class="ti ti-search"></i></span>
            <input type="search" class="form-control" placeholder="جستجو در کاربران (نام، نام کاربری، نقش، وضعیت...)" id="searchInput" autocomplete="off">
        </div>
        <div class="table-responsive">
            <table class="table table-hover text-nowrap w-100 ims-table" id="usersTable">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>نام کاربری</th>
                        <th>نقش</th>
                        <th>تاریخ ثبت</th>
                        <th>آخرین ورود</th>
                        <th>وضعیت</th>
                        <th data-orderable="false">عملیات</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @if (Model != null)
                    {
                        foreach (var user in Model)
                        {
                            <tr data-user-id="@user.UserId">
                                <td data-order="@user.Name @user.LastName">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar avatar-sm avatar-rounded bg-primary-transparent">
                                            @((user.Name?.Trim().FirstOrDefault().ToString() ?? "").ToUpper())
                                        </span>
                                        <div class="fw-medium">@user.Name @user.LastName</div>
                                    </div>
                                </td>
                                <td class="dir-ltr text-end">@user.Username</td>
                                <td><span class="badge bg-info-transparent">@user.Role</span></td>
                                <td data-order="@user.CreatedAt?.ToString("yyyyMMddHHmmss")">
                                    <div>@user.CreatedAt.ToPersianDate()</div>
                                    <small class="text-muted dir-ltr d-inline-block">@user.CreatedAt.ToPersianTime()</small>
                                </td>
                                <td data-order="@user.LastLogin?.ToString("yyyyMMddHHmmss")">
                                    <div>@user.LastLogin.ToPersianDate()</div>
                                    <small class="text-muted dir-ltr d-inline-block">@user.LastLogin.ToPersianTime()</small>
                                </td>
                                <td class="text-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-transparent"><i class="ti ti-circle-check me-1"></i>فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-transparent"><i class="ti ti-circle-x me-1"></i>غیرفعال</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-icon btn-sm btn-primary-light btn-edit" data-id="@user.UserId" data-bs-toggle="tooltip" title="ویرایش">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        @if (user.IsActive)
                                        {
                                            <button type="button" class="btn btn-icon btn-sm btn-danger-light btn-delete" data-id="@user.UserId" data-bs-toggle="tooltip" title="غیرفعال‌سازی">
                                                <i class="ti ti-user-off"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-icon btn-sm btn-success-light btn-restore" data-id="@user.UserId" data-bs-toggle="tooltip" title="فعال‌سازی">
                                                <i class="ti ti-user-check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal افزودن کاربر  -->
<div class="modal fade ims-modal" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <span class="avatar avatar-md avatar-rounded bg-primary-transparent modal-icon"><i class="ti ti-user-plus fs-18"></i></span>
                <div>
                    <h6 class="modal-title" id="addUserModalLabel">افزودن کاربر جدید</h6>
                    <div class="modal-subtitle">اطلاعات هویتی، نقش و رمز عبور کاربر را وارد کنید</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <form id="createUserForm" asp-controller="Home" asp-action="CreateUser" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="row gy-3">
                        <div class="col-xl-6">
                            <label class="form-label" for="Name">نام</label>
                            <input class="form-control" id="Name" name="Name" required>
                            <div class="valid-feedback">معتبر است!</div>
                            <div class="invalid-feedback">لطفاً نام را وارد کنید.</div>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="LastName">نام خانوادگی</label>
                            <input class="form-control" id="LastName" name="LastName" required>
                            <div class="valid-feedback">معتبر است!</div>
                            <div class="invalid-feedback">لطفاً نام خانوادگی را وارد کنید.</div>
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="Username">نام کاربری</label>
                            <input class="form-control" id="Username" name="Username" required>
                            <div class="valid-feedback">معتبر است!</div>
                            <div class="invalid-feedback">لطفاً نام کاربری را وارد کنید.</div>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="NationalId">کد ملی</label>
                            <input class="form-control" id="NationalId" name="NationalId" required maxlength="10">
                            <div class="valid-feedback">معتبر است!</div>
                            <div class="invalid-feedback">لطفاً کد ملی را وارد کنید.</div>
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="MobileNumberAdd">شماره موبایل</label>
                            <input class="form-control" id="MobileNumberAdd" name="MobileNumber" maxlength="11" inputmode="numeric" placeholder="09xxxxxxxxx">
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="RoleId">نقش کاربر</label>
                            <select class="form-control" id="RoleId" name="RoleId" required>
                                <option value="">در حال بارگذاری...</option>
                            </select>
                            <div class="valid-feedback">معتبر است!</div>
                            <div class="invalid-feedback">لطفاً نقش کاربر را انتخاب کنید.</div>
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="Password">رمز عبور</label>
                            <div class="input-group">
                                <span class="input-group-text toggle-password" style="cursor:pointer;"><i class="ti ti-eye"></i></span>
                                <input class="form-control" type="password" id="Password" name="Password" placeholder="رمز عبور" autocomplete="new-password" required minlength="6">
                            </div>
                            <div class="invalid-feedback d-block" id="passwordFeedback" style="display:none !important;">لطفاً رمز عبور را وارد کنید (حداقل 6 کاراکتر).</div>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="ConfirmPassword">تأیید رمز عبور</label>
                            <div class="input-group">
                                <span class="input-group-text toggle-password" style="cursor:pointer;"><i class="ti ti-eye"></i></span>
                                <input class="form-control" type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="تأیید رمز عبور" autocomplete="new-password" required>
                            </div>
                            <div id="passwordMismatch" class="text-danger fs-12 mt-1 d-none">رمز عبور و تأیید رمز عبور یکسان نیستند.</div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-light" type="button" data-bs-dismiss="modal">انصراف</button>
                        <button class="btn btn-primary btn-wave" type="submit"><i class="ti ti-check me-1"></i>ثبت کاربر</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal ویرایش کاربر -->
<div class="modal fade ims-modal" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <span class="avatar avatar-md avatar-rounded bg-primary-transparent modal-icon"><i class="ti ti-user-edit fs-18"></i></span>
                <div>
                    <h6 class="modal-title" id="editUserModalLabel">ویرایش کاربر</h6>
                    <div class="modal-subtitle">برای عدم تغییر رمز عبور، فیلدهای رمز را خالی بگذارید</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm" asp-controller="Home" asp-action="UpdateUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" name="UserId" />

                    <div class="row gy-3">
                        <div class="col-xl-6">
                            <label class="form-label" for="editName">نام</label>
                            <input class="form-control" id="editName" name="Name">
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="editLastName">نام خانوادگی</label>
                            <input class="form-control" id="editLastName" name="LastName">
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="editUsername">نام کاربری</label>
                            <input class="form-control" id="editUsername" name="Username">
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="editNationalId">کد ملی</label>
                            <input class="form-control" id="editNationalId" name="NationalId" maxlength="10">
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="editRoleId">نقش کاربر</label>
                            <select class="form-control" id="editRoleId" name="RoleId">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="editMobileNumber">شماره موبایل</label>
                            <input class="form-control" id="editMobileNumber" name="MobileNumber" maxlength="11" inputmode="numeric" placeholder="09xxxxxxxxx">
                        </div>

                        <div class="col-xl-6">
                            <label class="form-label" for="editPassword">رمز عبور جدید</label>
                            <div class="input-group">
                                <span class="input-group-text toggle-password" style="cursor:pointer;"><i class="ti ti-eye"></i></span>
                                <input class="form-control" type="password" id="editPassword" name="Password" minlength="6" autocomplete="new-password">
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="editConfirmPassword">تأیید رمز عبور</label>
                            <div class="input-group">
                                <span class="input-group-text toggle-password" style="cursor:pointer;"><i class="ti ti-eye"></i></span>
                                <input class="form-control" type="password" id="editConfirmPassword" name="ConfirmPassword" autocomplete="new-password">
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-light" type="button" data-bs-dismiss="modal">انصراف</button>
                        <button class="btn btn-primary btn-wave" type="submit"><i class="ti ti-check me-1"></i>به‌روزرسانی</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/assets/plugins/datatable/datatables.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        let addModal, editModal;
        let roleChoicesAdd = null, roleChoicesEdit = null, pendingEditRoleId = null;

        addModal = new bootstrap.Modal(document.getElementById('addUserModal'));
        editModal = new bootstrap.Modal(document.getElementById('editUserModal'));

        loadRolesForModal('RoleId');
        loadRolesForModal('editRoleId');

        // دراپ‌داون‌های نقش با کامپوننت استاندارد یزن (Choices.js) — بعد از نمایش مودال init می‌شن
        // چون تا اون موقع مودال مخفیه (display:none) و همچنین گزینه‌ها ممکنه هنوز از سرور نیومده باشن
        document.getElementById('addUserModal').addEventListener('shown.bs.modal', function() {
            if (typeof Choices === 'undefined') return;
            if (!roleChoicesAdd) {
                roleChoicesAdd = new Choices('#RoleId', { searchEnabled: false, shouldSort: false, itemSelectText: '' });
            } else {
                roleChoicesAdd.setChoiceByValue('');
            }
        });

        document.getElementById('editUserModal').addEventListener('shown.bs.modal', function() {
            if (typeof Choices === 'undefined') return;
            if (!roleChoicesEdit) {
                roleChoicesEdit = new Choices('#editRoleId', { searchEnabled: false, shouldSort: false, itemSelectText: '' });
            }
            if (pendingEditRoleId != null) {
                roleChoicesEdit.setChoiceByValue(String(pendingEditRoleId));
                pendingEditRoleId = null;
            }
        });

        document.getElementById('AddUser').addEventListener('click', function() {
            document.getElementById('createUserForm').reset();
            document.getElementById('createUserForm').classList.remove('was-validated');
            addModal.show();
        });

        // جدول با DataTables قالب یزن: جستجو، مرتب‌سازی و صفحه‌بندی
        var usersDt = $('#usersTable').DataTable({
            order: [[3, 'desc']],
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            dom: "<'ims-dt-top'l>t<'ims-dt-footer'<'dt-info'i><'dt-pages'p>>",
            language: {
                lengthMenu: 'نمایش _MENU_ ردیف',
                zeroRecords: 'هیچ کاربری یافت نشد.',
                emptyTable: 'هیچ کاربری یافت نشد.',
                info: 'نمایش _START_ تا _END_ از _TOTAL_ کاربر',
                infoEmpty: 'کاربری برای نمایش وجود ندارد',
                infoFiltered: '(فیلتر شده از _MAX_ کاربر)',
                paginate: { first: 'اول', last: 'آخر', next: 'بعدی', previous: 'قبلی' }
            }
        });

        document.getElementById('searchInput').addEventListener('input', function() {
            usersDt.search(this.value).draw();
        });

        // رویدادها delegated هستن چون DataTables ردیف‌های صفحه‌های دیگه رو از DOM برمی‌داره
        var tableBody = document.getElementById('usersTableBody');

        document.querySelectorAll('.toggle-password').forEach(function(element) {
            element.addEventListener('click', function() {
                var input = this.closest('.input-group').querySelector('input');
                var icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'ti ti-eye-off';
                } else {
                    input.type = 'password';
                    icon.className = 'ti ti-eye';
                }
            });
        });

        // ویرایش کاربر
        tableBody.addEventListener('click', function(ev) {
            var btn = ev.target.closest('.btn-edit');
            if (!btn) return;
            {
                var userId = btn.dataset.id;

                fetch('@Url.Action("EditUser", "Home")?id=' + userId, {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        document.getElementById('editUserId').value = response.userId;
                        document.getElementById('editName').value = response.name;
                        document.getElementById('editLastName').value = response.lastName;
                        document.getElementById('editUsername').value = response.username;
                        document.getElementById('editNationalId').value = response.nationalId;
                        document.getElementById('editMobileNumber').value = response.mobileNumber || '';
                        if (roleChoicesEdit) {
                            roleChoicesEdit.setChoiceByValue(String(response.roleId));
                        } else {
                            pendingEditRoleId = response.roleId;
                            document.getElementById('editRoleId').value = response.roleId;
                        }
                        document.getElementById('editPassword').value = '';
                        document.getElementById('editConfirmPassword').value = '';
                        editModal.show();
                    } else {
                        imsToast('error', response.message);
                    }
                })
                .catch(function() {
                    imsToast('error', 'خطا در دریافت اطلاعات کاربر');
                });
            }
        });

        // غیرفعال‌سازی کاربر
        tableBody.addEventListener('click', function(ev) {
            var btn = ev.target.closest('.btn-delete');
            if (!btn) return;
            {
                var userId = btn.dataset.id;
                if (!confirm('آیا از غیرفعال‌سازی این کاربر اطمینان دارید؟')) return;

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                fetch('@Url.Action("SoftDeleteUser", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: 'id=' + userId
                })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        setTimeout(function() { location.reload(); }, 800);
                    } else {
                        imsToast('error', response.message);
                    }
                })
                .catch(function() { imsToast('error', 'خطا در غیرفعال‌سازی کاربر'); });
            }
        });

        // فعال‌سازی مجدد کاربر
        tableBody.addEventListener('click', function(ev) {
            var btn = ev.target.closest('.btn-restore');
            if (!btn) return;
            {
                var userId = btn.dataset.id;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                fetch('@Url.Action("RestoreUser", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: 'id=' + userId
                })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        setTimeout(function() { location.reload(); }, 800);
                    } else {
                        imsToast('error', response.message);
                    }
                })
                .catch(function() { imsToast('error', 'خطا در فعال‌سازی کاربر'); });
            }
        });

        // ارسال فرم ویرایش
        document.getElementById('editUserForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var password = document.getElementById('editPassword').value;
            var confirmPassword = document.getElementById('editConfirmPassword').value;

            if (password && password !== confirmPassword) {
                imsToast('warning', 'رمز عبور و تأیید رمز عبور یکسان نیستند');
                return;
            }

            var form = this;
            var formData = new FormData(form);
            var urlEncodedData = new URLSearchParams(formData).toString();
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: urlEncodedData
            })
            .then(response => response.json())
            .then(response => {
                if (response.success) {
                    editModal.hide();
                    setTimeout(function() { location.reload(); }, 800);
                } else {
                    imsToast('error', response.message || 'خطا در به‌روزرسانی');
                }
            })
            .catch(function() { imsToast('error', 'خطا در به‌روزرسانی کاربر'); });
        });

        // ارسال فرم ایجاد کاربر
        document.getElementById('createUserForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var password = document.getElementById('Password').value;
            var confirmPassword = document.getElementById('ConfirmPassword').value;

            if (password !== confirmPassword) {
                document.getElementById('passwordMismatch').classList.remove('d-none');
                return;
            }
            document.getElementById('passwordMismatch').classList.add('d-none');

            var form = this;
            var formData = new FormData(form);
            var urlEncodedData = new URLSearchParams(formData).toString();
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: urlEncodedData
            })
            .then(response => response.json())
            .then(response => {
                if (response.success) {
                    addModal.hide();
                    setTimeout(function() { location.reload(); }, 800);
                } else {
                    imsToast('error', response.message || 'خطا در ایجاد کاربر');
                }
            })
            .catch(function() { imsToast('error', 'خطا در ایجاد کاربر'); });
        });

        document.getElementById('addUserModal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('createUserForm').reset();
            document.getElementById('createUserForm').classList.remove('was-validated');
            document.getElementById('passwordMismatch').classList.add('d-none');
            if (roleChoicesAdd) roleChoicesAdd.setChoiceByValue('');
        });

        document.getElementById('editUserModal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('editUserForm').reset();
        });
    });

    function loadRolesForModal(selectId) {
        fetch('@Url.Action("GetRoles", "Home")', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(roles => {
            var roleSelect = document.getElementById(selectId);
            roleSelect.innerHTML = '<option value="">انتخاب کنید</option>';

            if (roles && Array.isArray(roles) && roles.length > 0) {
                roles.forEach(function(role) {
                    var option = document.createElement('option');
                    option.value = role.roleId;
                    option.textContent = role.roleName;
                    roleSelect.appendChild(option);
                });
            }
        })
        .catch(function() {
            document.getElementById(selectId).innerHTML = '<option value="">خطا در بارگذاری</option>';
        });
    }
</script>
}
