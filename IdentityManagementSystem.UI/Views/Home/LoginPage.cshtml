@model IdentityManagementSystem.UI.ViewModels.LoginViewModel
@using DNTCaptcha.Core
@{
    ViewData["Title"] = "ورود به سامانه";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="container-lg">
    <div class="snow-container"></div>
    <div class="row justify-content-center align-items-center authentication authentication-basic h-100">
        <div class="col-xl-11">
            <div class="row justify-content-center">
                <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6 col-sm-8 col-12">

                    <!-- لوگو -->
                    <div class="my-5 d-flex justify-content-center">
                        <a href="javascript:void(0);">
                            <img src="~/assets/images/brand-logos/desktop-logo.png"
                                 alt="Logo"
                                 class="authentication-brand desktop-logo">
                            <img src="~/assets/images/brand-logos/desktop-dark.png"
                                 alt="Logo"
                                 class="authentication-brand desktop-dark">
                        </a>
                    </div>

                    <!-- کارت لاگین -->
                    <div class="card custom-card my-4">
                        <div class="card-body p-5">
                            <p class="h4 mb-2 fw-semibold">ورود به سامانه</p>
                            <p class="mb-4 text-muted">لطفاً نام کاربری و رمز عبور خود را وارد کنید</p>

                            <form id="loginForm" asp-action="LoginPage" method="post" autocomplete="off">
                                <div class="row gy-3">

                                    <!-- نام کاربری -->
                                    <div class="col-xl-12">
                                        <label class="form-label text-default" asp-for="Username">نام کاربری</label>
                                        <input asp-for="Username"
                                               class="form-control form-control-lg"
                                               placeholder="نام کاربری را وارد کنید"
                                               autocomplete="username" />
                                        <span asp-validation-for="Username" class="text-danger d-block mt-1"></span>
                                    </div>

                                    <!-- رمز عبور -->
                                    <div class="col-xl-12">
                                        <label class="form-label text-default" asp-for="Password">رمز عبور</label>
                                        <div class="position-relative">
                                            <input asp-for="Password"
                                                   type="password"
                                                   class="form-control form-control-lg"
                                                   id="login-password"
                                                   placeholder="رمز عبور"
                                                   autocomplete="current-password" />
                                            <a href="javascript:void(0);"
                                               class="show-password-button text-muted"
                                               onclick="createpassword('login-password', this)">
                                                <i class="ri-eye-off-line align-middle"></i>
                                            </a>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger d-block mt-1"></span>
                                    </div>

                                    <!-- کپچا -->
                                    <div class="col-xl-12">
                                        <div id="securitySection" class="mt-2">
                                            <dnt-captcha asp-captcha-generator-max="9999"
                                                         asp-captcha-generator-min="1000"
                                                         asp-captcha-generator-language="English"
                                                         asp-captcha-generator-display-mode="ShowDigits"
                                                         asp-use-relative-urls="true"
                                                         asp-placeholder="کد امنیتی را وارد کنید"
                                                         asp-validation-error-message="کد امنیتی اشتباه است. لطفاً کد جدید را وارد کنید."
                                                         asp-too-many-requests-error-message="درخواست‌های زیاد! لطفاً یک دقیقه صبر کنید!"
                                                         asp-font-name="Tahoma"
                                                         asp-font-size="30"
                                                         asp-fore-color="#333333"
                                                         asp-back-color="#FCF6F5FF"
                                                         asp-text-box-class="form-control form-control-lg"
                                                         asp-text-box-template="<div class='form-group'>{0}</div>"
                                                         asp-validation-message-class="text-danger"
                                                         asp-refresh-button-class="btn btn-light"
                                                         asp-show-refresh-button="true" />
                                        </div>
                                    </div>

                                </div>

                                <!-- دکمه ورود -->
                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-lg btn-primary">ورود</button>
                                </div>
                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        @if (TempData["SuccessLogoutMessage"] != null)
        {
                @:toastr.options = {
                @:"closeButton": true,
                @:"progressBar": true,
                @:"positionClass": "toast-top-left",
                @:"timeOut": "3000",
                @:"rtl": true
                @:};
                @:toastr.success('@TempData["SuccessLogoutMessage"]');
        }

        const jwtToken = '@ViewBag.JwtToken';
        if (jwtToken) {
            localStorage.setItem('jwtToken', jwtToken);
            window.location.href = '/Cartable/Index';
        }

        document.addEventListener('DOMContentLoaded', function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-left",
                "timeOut": "5000",
                "rtl": true
            };

            // نمایش خطاهای ولیدیشن با توستر
            const validationErrors = document.querySelectorAll('.field-validation-error, .text-danger');
            validationErrors.forEach(err => {
                const text = err.textContent.trim();
                if (text !== '' && text.length > 3) {
                    toastr.error(text);
                }
            });

            if ('@(!string.IsNullOrEmpty(ViewBag.ErrorMessage) ? ViewBag.ErrorMessage : "")' !== '') {
                toastr.error('@(!string.IsNullOrEmpty(ViewBag.ErrorMessage) ? ViewBag.ErrorMessage : "")');
            }
        });
    </script>
}