@using IdentityManagementSystem.UI.Controllers
@model IdentityManagementSystem.UI.Controllers.PaginatedCartableViewModel
@{
    ViewData["Title"] = "داشبورد متقاضی";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formModel = ViewBag.FormModel as IdentityManagementSystem.UI.Controllers.CartableFormViewModel ?? new IdentityManagementSystem.UI.Controllers.CartableFormViewModel();
    var currentSearch = Context.Request.Query["search"].ToString();
}
<link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />

<!-- جستجو -->
<div class="row mb-4">
    <div class="col-12">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <input type="text"
                   class="form-control"
                   name="search"
                   value="@currentSearch"
                   placeholder="جستجو بر اساس شماره درخواست، کد ملی یا شناسه سند..."
                   style="max-width: 360px;" />
            <button type="submit" class="btn btn-primary">
                <i class="ri-search-line"></i>
            </button>
        </form>
    </div>
</div>

<!-- کارت جدول -->
<div class="card custom-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="card-title mb-0">درخواست‌های من</div>
        <button id="AddDoc" type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#scrollingmodal">
            <i class="ri-add-line me-1"></i> درخواست جدید
        </button>
    </div>
    <div class="card-body">
        @if (ViewBag.ErrorMessage != null)
        {
            <script>toastr.error('@ViewBag.ErrorMessage');</script>
        }
        @if (ViewBag.SuccessMessage != null)
        {
            <script>toastr.success('@ViewBag.SuccessMessage');</script>
        }
        <div class="table-responsive">
            <table id="applicantTable" class="table table-bordered text-nowrap">
                <thead>
                    <tr>
                        <th>شماره درخواست</th>
                        <th>تاریخ ایجاد</th>
                        <th>کد ملی</th>
                        <th>شماره همراه</th>
                        <th>شناسه سند</th>
                        <th>رمز تصدیق</th>
                        <th>شماره قبض انبار</th>
                        <th>نمایش سند</th>
                        <th>وضعیت</th>
                    </tr>
                </thead>
                <tbody id="applicantBody">
                    @foreach (var item in Model.Items)
                    {
                        string statusText;
                        string statusClass;
                        if (item.ValidateByExpert == true)
                        {
                            statusText = "تایید شده";
                            statusClass = "badge bg-success";
                        }
                        else if (item.ValidateByExpert == false)
                        {
                            statusText = "رد شده";
                            statusClass = "badge bg-danger";
                        }
                        else
                        {
                            statusText = "در انتظار بررسی";
                            statusClass = "badge bg-warning text-dark";
                        }

                        <tr data-request-id="@item.RequestId">
                            <td>@item.RequestId</td>
                            <td>
                                <div>@item.CreatedAt.ToPersianTime()</div>
                                <small class="text-muted">@item.CreatedAt.ToPersianDate()</small>
                            </td>
                            <td>@item.NationalId</td>
                            <td>@item.MobileNumber</td>
                            <td>@item.DocumentNumber</td>
                            <td>@item.VerificationCode</td>
                            <td>@(string.IsNullOrEmpty(item.WarehouseReceiptNumber) ? "—" : item.WarehouseReceiptNumber)</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-light btn-view-doc" data-request-id="@item.RequestId" title="مشاهده متن سند">
                                    <i class="ri-file-text-line @(item.IsRead ? "text-success" : "text-primary")"></i>
                                </button>
                            </td>
                            <td class="text-center">
                                <span class="@statusClass"
                                      @(item.ValidateByExpert == false && !string.IsNullOrEmpty(item.RejectReasonDisplay) ? Html.Raw($"data-bs-toggle=\"tooltip\" title=\"{item.RejectReasonDisplay}\"") : Html.Raw(""))>
                                    @statusText
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- صفحه‌بندی -->
        <nav class="mt-3">
            <ul class="pagination justify-content-end mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ClientIndex", new { page = Model.CurrentPage - 1, search = Model.SearchQuery })">
                        <i class="ri-arrow-right-s-line"></i>
                    </a>
                </li>
                @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ClientIndex", new { page = i, search = Model.SearchQuery })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ClientIndex", new { page = Model.CurrentPage + 1, search = Model.SearchQuery })">
                        <i class="ri-arrow-left-s-line"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- ==================== مودال‌ها ==================== -->
<!-- مودال نمایش سند -->
<div class="modal fade" id="documentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentModalLabel">متن سند</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="documentModalBody">
                <div class="text-center text-muted py-5">در حال بارگذاری...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد درخواست جدید -->
<div class="modal fade" id="scrollingmodal" tabindex="-1" aria-labelledby="scrollingmodalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="scrollingmodalLabel">ایجاد درخواست جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="ValidateSteps" method="post" id="needs-validation-form" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- بخش اطلاعات متقاضی -->
                    <div class="mb-4">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-user-line me-1"></i>
                            اطلاعات متقاضی
                        </p>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="NationalCode" class="form-label text-default">کد ملی</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="NationalCode"
                                       name="NationalCode"
                                       placeholder="کد ملی ۱۰ رقمی"
                                       maxlength="10"
                                       inputmode="numeric"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="MobileNumber" class="form-label text-default">شماره موبایل</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="MobileNumber"
                                       name="MobileNumber"
                                       placeholder="مثلاً 09123456789"
                                       maxlength="11"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>

                        <!-- دکمه ارسال کد دو عاملی -->
                        <div class="mt-3">
                            <button type="button" id="btnSendOtp" class="btn btn-outline-primary btn-sm">
                                <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                            </button>
                            <span id="otpTimer" class="text-muted ms-2" style="display:none;"></span>
                        </div>

                        <!-- فیلد کد دو عاملی -->
                        <div class="row gy-3 mt-2" id="otpSection" style="display:none;">
                            <div class="col-md-6">
                                <label for="OtpCode" class="form-label text-default">کد تایید پیامکی</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="OtpCode"
                                       name="OtpCode"
                                       placeholder="کد ۶ رقمی"
                                       maxlength="6"
                                       inputmode="numeric" />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="button" id="btnVerifyOtp" class="btn btn-success btn-sm">
                                    تایید کد
                                </button>
                            </div>
                        </div>

                        <div id="otpMessage" class="mt-2"></div>
                    </div>

                    <hr class="my-4" />

                    <!-- بخش اطلاعات سند -->
                    <div class="mb-2">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-file-text-line me-1"></i>
                            اطلاعات سند
                        </p>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="DocumentNumber" class="form-label text-default">شناسه سند</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="DocumentNumber"
                                       name="DocumentNumber"
                                       placeholder="شناسه سند را وارد کنید"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="VerifyCode" class="form-label text-default">رمز تصدیق</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="VerifyCode"
                                       name="VerifyCode"
                                       placeholder="رمز تصدیق را وارد کنید"
                                       required />
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- بخش قبض انبار -->
                    <div class="mb-2">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-archive-line me-1"></i>
                            قبض انبار
                        </p>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="WarehouseReceiptNumber" class="form-label text-default">شماره قبض انبار</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="WarehouseReceiptNumber"
                                       name="WarehouseReceiptNumber"
                                       placeholder="شماره قبض انبار را وارد کنید" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" form="needs-validation-form" id="btnVerify" class="btn btn-primary" disabled>
                    ثبت درخواست
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // تابع نمایش پیام — از toastr استفاده می‌کنه (کتابخانه‌ی toastify روی این پروژه لود نمی‌شه)
        function showToast(message, type = 'success') {
            const fn = { success: 'success', error: 'error', warning: 'warning', info: 'info' }[type] || 'success';
            toastr[fn](message);
        }

        $(document).ready(function () {
            $("#global-loader").fadeOut("slow");

            let otpVerified = false;
            let otpTimerInterval = null;
            let remainingSeconds = 0;

            // ریست فرم مودال
            $('#scrollingmodal').on('hidden.bs.modal', function () {
                $('#needs-validation-form')[0].reset();
                otpVerified = false;
                $('#otpSection').hide();
                $('#otpMessage').html('');
                $('#btnVerify').prop('disabled', true);
                $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                clearInterval(otpTimerInterval);
                $('#otpTimer').hide();
            });

            // ارسال کد OTP
                    $('#btnSendOtp').click(function () {
            const nationalCode = $('#NationalCode').val().trim();
            const mobile = $('#MobileNumber').val().trim();

            if (!nationalCode || nationalCode.length !== 10) {
                showToast('کد ملی را به درستی وارد کنید', 'warning');
                return;
            }
            if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                showToast('شماره موبایل را به درستی وارد کنید', 'warning');
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

            $.post('/Cartable/SendOtp', {
                nationalCode: nationalCode,
                mobileNumber: mobile
            })
            .done(function (res) {
                console.log('پاسخ SendOtp:', res);   // برای دیدن پاسخ

                if (res.success) {
                    showToast(res.message || 'کد تایید ارسال شد', 'success');

                    if (res.debugOtp) {
                        showToast('کد تست: ' + res.debugOtp, 'info');
                        console.log('OTP برای تست:', res.debugOtp);
                    }

                    $('#otpSection').slideDown();
                    startOtpTimer(120);
                } else {
                    showToast(res.message || 'خطا در ارسال کد', 'error');
                }
            })
            .fail(function (xhr) {
                console.error('خطا در SendOtp:', xhr);
                showToast('خطا در ارتباط با سرور', 'error');
            })
            .always(function () {
                // این خط خیلی مهمه - دکمه رو همیشه برمی‌گردونه
                btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
            });
        });

            // تایید کد OTP
            $('#btnVerifyOtp').click(function () {
                const otp = $('#OtpCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!otp || otp.length !== 6) {
                    showToast('کد ۶ رقمی را وارد کنید', 'warning');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', {
                    mobileNumber: mobile,
                    otpCode: otp
                })
                .done(function (res) {
                    if (res.success) {
                        otpVerified = true;
                        $('#otpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                        $('#btnVerify').prop('disabled', false);
                        $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', true);
                        showToast('کد تایید صحیح است', 'success');
                    } else {
                        $('#otpMessage').html('<small class="text-danger">' + (res.message || 'کد اشتباه است') + '</small>');
                        showToast(res.message || 'کد اشتباه است', 'error');
                        btn.prop('disabled', false).html('تایید کد');
                    }
                })
                .fail(function () {
                    showToast('خطا در ارتباط با سرور', 'error');
                    btn.prop('disabled', false).html('تایید کد');
                });
            });

            // تایمر OTP
            function startOtpTimer(seconds) {
                remainingSeconds = seconds;
                $('#otpTimer').show();
                clearInterval(otpTimerInterval);

                otpTimerInterval = setInterval(function () {
                    remainingSeconds--;
                    const min = Math.floor(remainingSeconds / 60);
                    const sec = remainingSeconds % 60;
                    $('#otpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (remainingSeconds <= 0) {
                        clearInterval(otpTimerInterval);
                        $('#otpTimer').hide();
                        $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال مجدد کد');
                    }
                }, 1000);
            }

            // نمایش متن سند
            $(document).on('click', '.btn-view-doc', function () {
                const requestId = $(this).data('request-id');
                $('#documentModalLabel').text('متن سند درخواست ' + requestId);
                $('#documentModalBody').html('<div class="text-center py-5"><div class="spinner-border"></div><div class="mt-2">در حال بارگذاری...</div></div>');
                $('#documentModal').modal('show');

                $.get('/Cartable/GetDocumentText', { requestId: requestId })
                    .done(function (res) {
                        if (res?.success && res.documentText?.trim()) {
                            let safe = $('<div/>').text(res.documentText).html();
                            safe = safe.replace(
                                /(مهلت اعتبار این وکالتنامه تا تاریخ\s*\d{4}\/\d{2}\/\d{2}\s*می باشد)/g,
                                '<strong class="text-danger">$1</strong>'
                            );
                            $('#documentModalBody').html(
                                '<pre class="document-content" style="white-space:pre-wrap;line-height:1.8;background:#f8f9fa;padding:1rem;border-radius:8px;">' + safe + '</pre>'
                            );
                        } else {
                            $('#documentModalBody').html('<p class="text-danger text-center py-4">رمز تصدیق یا شماره سند صحیح نیست.</p>');
                            showToast(res?.message || 'اطلاعات سند صحیح نیست', 'error');
                        }
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.message || 'خطا در دریافت سند';
                        $('#documentModalBody').html('<p class="text-danger text-center py-4">' + msg + '</p>');
                        showToast(msg, 'error');
                    });
            });

            // فرم درخواست جدید
            $('#needs-validation-form').on('submit', function (e) {
                e.preventDefault();

                if (!otpVerified) {
                    showToast('لطفاً ابتدا کد تایید پیامکی را وارد و تایید کنید', 'warning');
                    return;
                }

                const btn = $('#btnVerify');
                if (!this.checkValidity()) {
                    showToast('لطفاً فیلدهای الزامی را پر کنید', 'error');
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done(function (data) {
                        if (data && data.success) {
                            showToast(data.message || 'درخواست با موفقیت ثبت شد', 'success');
                            $('#scrollingmodal').modal('hide');
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            showToast((data && data.message) || 'اطلاعات وارد شده معتبر نیست.', 'error');
                            btn.prop('disabled', false).html('ثبت درخواست');
                        }
                    })
                    .fail(function (xhr) {
                        showToast(xhr.responseJSON?.message || 'خطا در ارسال درخواست', 'error');
                        btn.prop('disabled', false).html('ثبت درخواست');
                    });
            });
        });
    </script>
}