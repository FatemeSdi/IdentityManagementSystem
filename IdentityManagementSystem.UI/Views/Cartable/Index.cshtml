@using IdentityManagementSystem.UI.Controllers
@model IdentityManagementSystem.UI.Controllers.PaginatedCartableViewModel
@{
    ViewData["Title"] = "کارتابل";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formModel = ViewBag.FormModel as IdentityManagementSystem.UI.Controllers.CartableFormViewModel ?? new IdentityManagementSystem.UI.Controllers.CartableFormViewModel();
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentFilter = ViewBag.FilterStatus as string ?? "";
}

<link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />

<!-- جستجو و فیلتر -->
<div class="row mb-4">
    <div class="col-12">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <input type="text"
                   class="form-control"
                   name="search"
                   value="@currentSearch"
                   placeholder="جستجو..."
                   style="max-width: 280px;" />

            <select name="filterStatus" class="form-select" style="max-width: 200px;">
                <option value="">همه درخواست‌ها</option>
                <option value="approved" selected="@(currentFilter == "approved")">تایید شده</option>
                <option value="rejected" selected="@(currentFilter == "rejected")">رد شده</option>
                <option value="pending" selected="@(currentFilter == "pending")">در انتظار بررسی</option>
            </select>

            <button type="submit" class="btn btn-primary">
                <i class="ri-search-line"></i>
            </button>
        </form>
    </div>
</div>

<!-- کارت جدول -->
<div class="card custom-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="card-title mb-0">درخواست‌ها</div>
        <button id="AddDoc" type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#scrollingmodal">
            <i class="ri-add-line me-1"></i> سند جدید
        </button>
    </div>
    <div class="card-body">

        @if (ViewBag.ErrorMessage != null)
        {
            <script>toastr.error('@ViewBag.ErrorMessage');</script>
        }
        @if (ViewBag.SuccessMessage != null)
        {
            <script>toastr.success('@ViewBag.SuccessMessage');</script>
        }

        <div class="table-responsive">  
            <table id="cartableTable" class="table table-bordered text-nowrap">
                <thead>
                    <tr>
                        <th>شماره درخواست</th>
                        <th>تاریخ ایجاد</th>
                        <th>کد ملی</th>
                        <th>شماره همراه</th>
                        <th>شناسه سند</th>
                        <th>رمز تصدیق</th>
                        <th>احراز هویت متقاضی</th>
                        <th>احراز اصالت سند</th>
                        <th>ارتباط متقاضی با سند</th>
                        <th>احراز وکالت</th>
                        <th>نمایش سند</th>
                        <th>تایید درخواست</th>
                    </tr>
                </thead>
                <tbody id="cartableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr data-request-id="@item.RequestId">
                            <td>@item.RequestId</td>
                            <td>
                                <div>@item.CreatedAt.ToPersianTime()</div>
                                <small class="text-muted">@item.CreatedAt.ToPersianDate()</small>
                            </td>
                            <td>@item.NationalId</td>
                            <td>@item.MobileNumber</td>
                            <td>@item.DocumentNumber</td>
                            <td>@item.VerificationCode</td>

                            <!-- احراز هویت متقاضی -->
                            <td class="text-center">
                                @if (item.IsMatch == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsMatch == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- احراز اصالت سند -->
                            <td class="text-center">
                                @if (item.IsExist == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="وجود دارد"></i>
                                }
                                else if (item.IsExist == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="وجود ندارد"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- ارتباط متقاضی با سند -->
                            <td class="text-center">
                                @if (item.IsNationalIdInResponse == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsNationalIdInResponse == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- احراز وکالت -->
                            <td class="text-center">
                                @if (item.IsNationalIdInLawyers == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsNationalIdInLawyers == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- نمایش سند -->
                            <td class="text-center">
                                <button class="btn btn-sm btn-light btn-view-doc" data-request-id="@item.RequestId" title="مشاهده متن سند">
                                    <i class="ri-file-text-line @(item.IsRead ? "text-success" : "text-primary")"></i>
                                </button>
                            </td>

                            <!-- تایید / رد -->
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button"
                                            class="btn @(item.ValidateByExpert == true ? "btn-success" : "btn-outline-success") approve-btn"
                                            data-request-id="@item.RequestId">
                                        تایید
                                    </button>
                                    <button type="button"
                                            class="btn @(item.ValidateByExpert == false ? "btn-danger" : "btn-outline-danger") reject-btn"
                                            data-request-id="@item.RequestId">
                                        رد
                                    </button>
                                </div>

                                @if (item.ValidateByExpert == false && !string.IsNullOrEmpty(item.RejectReasonDisplay))
                                {
                                    <div class="mt-1">
                                        <small class="text-danger reject-reason-text"
                                               style="cursor:pointer; text-decoration:underline dotted;"
                                               data-reason="@item.RejectReasonDisplay"
                                               title="@item.RejectReasonDisplay">
                                            @(item.RejectReasonDisplay.Length > 40 ? item.RejectReasonDisplay.Substring(0, 40) + "..." : item.RejectReasonDisplay)
                                        </small>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- صفحه‌بندی -->
        <nav class="mt-3">
            <ul class="pagination justify-content-end mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">
                        <i class="ri-arrow-right-s-line"></i>
                    </a>
                </li>

                @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">
                        <i class="ri-arrow-left-s-line"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- ==================== مودال‌ها ==================== -->
<!-- مودال دلیل رد -->
<div class="modal fade" id="rejectReasonModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">دلیل عدم تایید</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="rejectReasonText" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال نمایش سند -->
<div class="modal fade" id="documentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentModalLabel">متن سند</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="documentModalBody">
                <div class="text-center text-muted py-5">در حال بارگذاری...</div>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="documentChecked">
                    <label class="form-check-label" for="documentChecked">متن سند بررسی شد</label>
                </div>
                <button type="button" class="btn btn-success" id="confirmDocument">تایید</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال رد درخواست -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">عدم تایید درخواست</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="rejectForm">
                    <input type="hidden" id="rejectRequestId" />
                    <div class="mb-3">
                        <label class="form-label">علت عدم تایید</label>
                        <select class="form-select" id="predefinedReason" asp-items="@ViewBag.RejectReasons">
                            <option value="">---</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات تکمیلی</label>
                        <textarea class="form-control" id="customDescription" rows="3" placeholder="اختیاری"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmReject">تایید</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد درخواست جدید -->
<div class="modal fade" id="scrollingmodal" tabindex="-1" aria-labelledby="scrollingmodalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="scrollingmodalLabel">ایجاد درخواست جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>

            <div class="modal-body p-4">
                <form asp-action="ValidateSteps" method="post" id="needs-validation-form" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- بخش اطلاعات متقاضی -->
                    <div class="mb-4">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-user-line me-1"></i>
                            اطلاعات متقاضی
                        </p>

                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="NationalCode" class="form-label text-default">کد ملی</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="NationalCode"
                                       name="NationalCode"
                                       placeholder="کد ملی ۱۰ رقمی"
                                       maxlength="10"
                                       inputmode="numeric"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="MobileNumber" class="form-label text-default">شماره موبایل</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="MobileNumber"
                                       name="MobileNumber"
                                       placeholder="مثلاً 09123456789"
                                       maxlength="11"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formModel?.Step1Message))
                        {
                            <div class="mt-2">
                                <small class="text-@(formModel.Step1Message.Contains("معتبر") ? "success" : "danger")">
                                    @formModel.Step1Message
                                </small>
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <!-- بخش اطلاعات سند -->
                    <div class="mb-2">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-file-text-line me-1"></i>
                            اطلاعات سند
                        </p>

                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="DocumentNumber" class="form-label text-default">شناسه سند</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="DocumentNumber"
                                       name="DocumentNumber"
                                       placeholder="شناسه سند را وارد کنید"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="VerifyCode" class="form-label text-default">رمز تصدیق</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="VerifyCode"
                                       name="VerifyCode"
                                       placeholder="رمز تصدیق را وارد کنید"
                                       required />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formModel?.Step2Message))
                        {
                            <div class="mt-2">
                                <small class="text-@(formModel.Step2Message.Contains("معتبر") ? "success" : "danger")">
                                    @formModel.Step2Message
                                </small>
                            </div>
                        }
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" form="needs-validation-form" id="btnVerify" class="btn btn-primary">
                    ثبت درخواست
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // مخفی کردن لودر (اگر هنوز مونده باشه)
            $("#global-loader").fadeOut("slow");

            let pendingReject = null;

            // ریست فرم مودال
            $('#scrollingmodal').on('hidden.bs.modal', function () {
                $('#needs-validation-form')[0].reset();
            });

            // نمایش متن سند
            $(document).on('click', '.btn-view-doc', function () {
                const requestId = $(this).data('request-id');
                $('#documentModalLabel').text('متن سند درخواست ' + requestId);
                $('#documentModalBody').html('<div class="text-center py-5"><div class="spinner-border"></div><div class="mt-2">در حال بارگذاری...</div></div>');
                $('#documentChecked').prop('checked', false).prop('disabled', false);
                $('#confirmDocument').data('request-id', requestId).prop('disabled', false);
                $('#documentModal').modal('show');

                $.get('/Cartable/GetDocumentText', { requestId: requestId })
                    .done(function (res) {
                        if (res?.success && res.documentText?.trim()) {
                            let safe = $('<div/>').text(res.documentText).html();
                            safe = safe.replace(
                                /(مهلت اعتبار این وکالتنامه تا تاریخ\s*\d{4}\/\d{2}\/\d{2}\s*می باشد)/g,
                                '<strong class="text-danger">$1</strong>'
                            );
                            $('#documentModalBody').html('<pre class="document-content" style="white-space:pre-wrap;line-height:1.8;background:#f8f9fa;padding:1rem;border-radius:8px;">' + safe + '</pre>');
                            $('#documentChecked').prop('checked', res.isRead === true);
                        } else {
                            $('#documentModalBody').html('<p class="text-danger text-center py-4">رمز تصدیق یا شماره سند صحیح نیست.</p>');
                            $('#documentChecked, #confirmDocument').prop('disabled', true);
                            toastr.error(res?.message || 'اطلاعات سند صحیح نیست');
                        }
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.message || 'خطا در دریافت سند';
                        $('#documentModalBody').html('<p class="text-danger text-center py-4">' + msg + '</p>');
                        $('#documentChecked, #confirmDocument').prop('disabled', true);
                        toastr.error(msg);
                    });
            });

            // تایید خواندن سند
            $('#confirmDocument').click(function () {
                if (!$('#documentChecked').is(':checked')) {
                    toastr.warning('لطفاً گزینه «متن سند بررسی شد» را تیک بزنید');
                    return;
                }
                const requestId = $(this).data('request-id');
                $.post('/Cartable/MarkDocumentAsRead', { requestId: requestId })
                    .done(function (res) {
                        if (res.success) {
                            toastr.success('سند به عنوان خوانده‌شده ثبت شد');
                            $('#documentModal').modal('hide');
                        } else {
                            toastr.error(res.message || 'خطا در ثبت');
                        }
                    })
                    .fail(() => toastr.error('خطا در ارتباط با سرور'));
            });

            // دکمه تایید
            $(document).on('click', '.approve-btn', function () {
                submitValidation($(this).data('request-id'), true, null);
            });

            // دکمه رد
            $(document).on('click', '.reject-btn', function () {
                pendingReject = { requestId: $(this).data('request-id') };
                $('#rejectRequestId').val(pendingReject.requestId);
                $('#predefinedReason').val('');
                $('#customDescription').val('');
                $('#rejectModal').modal('show');
            });

            // نمایش دلیل رد
            $(document).on('click', '.reject-reason-text', function () {
                $('#rejectReasonText').text($(this).data('reason') || 'دلیلی ثبت نشده');
                $('#rejectReasonModal').modal('show');
            });

            // تایید رد
            $('#confirmReject').click(function () {
                if (!pendingReject) return;
                let description = '';
                const reason = $('#predefinedReason option:selected').text().trim();
                const custom = $('#customDescription').val()?.trim();
                if (reason && reason !== "---") description = reason;
                if (custom) description += (description ? " - " : "") + custom;

                submitValidation(pendingReject.requestId, false, description || null);
                $('#rejectModal').modal('hide');
                pendingReject = null;
            });

            function submitValidation(requestId, validateByExpert, description) {
                const row = $(`tr[data-request-id="${requestId}"]`);
                const token = $('input[name="__RequestVerificationToken"]').val();
                fetch('/Cartable/UpdateValidationStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        RequestId: requestId,
                        ValidateByExpert: validateByExpert,
                        Description: description
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        toastr.success(data.message || "وضعیت به‌روز شد");
                        if (validateByExpert) {
                            row.find('.approve-btn').removeClass('btn-outline-success').addClass('btn-success');
                            row.find('.reject-btn').removeClass('btn-danger').addClass('btn-outline-danger');
                        } else {
                            row.find('.reject-btn').removeClass('btn-outline-danger').addClass('btn-danger');
                            row.find('.approve-btn').removeClass('btn-success').addClass('btn-outline-success');
                        }
                    } else {
                        toastr.error(data.message || "خطا");
                    }
                })
                .catch(() => toastr.error("خطا در ارتباط با سرور"));
            }

            // فرم درخواست جدید
            $('#needs-validation-form').on('submit', function (e) {
                e.preventDefault();
                const btn = $('#btnVerify');
                if (!this.checkValidity()) {
                    toastr.error('لطفاً فیلدهای الزامی را پر کنید');
                    return;
                }
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done((data) => {
                        if (data && data.success) {
                            toastr.success(data.message || 'درخواست با موفقیت ثبت شد');
                            $('#scrollingmodal').modal('hide');
                            // اجازه می‌دیم توست قبل از رفرش صفحه دیده بشه
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error((data && data.message) || 'اطلاعات وارد شده معتبر نیست.');
                            btn.prop('disabled', false).html('ثبت درخواست');
                        }
                    })
                    .fail((xhr) => {
                        toastr.error(xhr.responseJSON?.message || 'خطا در ارسال درخواست');
                        btn.prop('disabled', false).html('ثبت درخواست');
                    });
            });

            $('#rejectModal').on('hidden.bs.modal', () => pendingReject = null);
        });
    </script>
}