@using IdentityManagementSystem.UI.Controllers
@model IdentityManagementSystem.UI.Controllers.PaginatedCartableViewModel
@{
    ViewData["Title"] = "کارتابل";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formModel = ViewBag.FormModel as IdentityManagementSystem.UI.Controllers.CartableFormViewModel ?? new IdentityManagementSystem.UI.Controllers.CartableFormViewModel();
    var companies = ViewBag.Companies as List<IdentityManagementSystem.UI.Controllers.CompanyOption> ?? new List<IdentityManagementSystem.UI.Controllers.CompanyOption>();
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentFilter = ViewBag.FilterStatus as string ?? "";
    var currentUserId = Context.Session.GetString("UserId");

    var fromDateGregorian = ViewBag.FromDate as string;
    var toDateGregorian = ViewBag.ToDate as string;

    string ToPersianDisplay(string? g)
    {
        if (string.IsNullOrWhiteSpace(g)) return "";
        if (!DateTime.TryParseExact(g.Trim(), "yyyy/M/d", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
            return "";
        var pc = new System.Globalization.PersianCalendar();
        return $"{pc.GetYear(dt)}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
    }

    var fromDatePersianDisplay = ToPersianDisplay(fromDateGregorian);
    var toDatePersianDisplay = ToPersianDisplay(toDateGregorian);
    var hasCustomRange = !string.IsNullOrWhiteSpace(fromDateGregorian) || !string.IsNullOrWhiteSpace(toDateGregorian);
}

<link rel="stylesheet" href="~/css/IndexStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/persianDatepicker-default.css" asp-append-version="true" />
<link rel="stylesheet" href="~/assets/libs/choices.js/public/assets/styles/choices.min.css" />

<style>
    #cartableTable thead th {
        background-color: rgb(var(--primary-rgb));
        color: #fff;
        border-color: rgb(var(--primary-rgb));
        white-space: nowrap;
        vertical-align: middle;
    }
</style>

<!-- جستجو و فیلتر -->
<div class="row mb-1">
    <div class="col-12">
        <form asp-action="Index" method="get" id="cartableFilterForm" class="d-flex align-items-center gap-2 flex-wrap">
            <input type="text"
                   class="form-control"
                   name="search"
                   value="@currentSearch"
                   placeholder="جستجو..."
                   style="max-width: 280px;" />

            <select name="filterStatus" id="filterStatus" class="form-select" style="max-width: 200px;">
                <option value="">همه درخواست‌ها</option>
                <option value="approved" selected="@(currentFilter == "approved")">تایید شده</option>
                <option value="rejected" selected="@(currentFilter == "rejected")">رد شده</option>
                <option value="pending" selected="@(currentFilter == "pending")">در انتظار بررسی</option>
            </select>

            <input type="text"
                   id="fromDateDisplay"
                   class="form-control jalali-date-input"
                   placeholder="از تاریخ"
                   value="@fromDatePersianDisplay"
                   readonly
                   style="max-width: 140px;" />
            <input type="text"
                   id="toDateDisplay"
                   class="form-control jalali-date-input"
                   placeholder="تا تاریخ"
                   value="@toDatePersianDisplay"
                   readonly
                   style="max-width: 140px;" />
            <input type="hidden" name="fromDate" id="fromDateHidden" value="@fromDateGregorian" />
            <input type="hidden" name="toDate" id="toDateHidden" value="@toDateGregorian" />

            <button type="submit" class="btn btn-primary">
                <i class="ri-search-line"></i>
            </button>

            @if (hasCustomRange)
            {
                <a href="@Url.Action("Index", new { search = currentSearch, filterStatus = currentFilter })" class="btn btn-outline-secondary btn-sm">
                    <i class="ri-calendar-check-line me-1"></i> امروز
                </a>
            }
        </form>
    </div>
</div>
<div class="row mb-4">
    <div class="col-12">
        <small class="text-muted">
            <i class="ri-information-line"></i>
            @(hasCustomRange ? "بازه‌ی تاریخ سفارشی اعمال شده." : "بدون انتخاب بازه، فقط درخواست‌های امروز نمایش داده می‌شود .")
        </small>
    </div>
</div>

<!-- کارت جدول -->
<div class="card custom-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="card-title mb-0">درخواست‌ها</div>
        <button id="AddDoc" type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#scrollingmodal">
            <i class="ri-add-line me-1"></i> سند جدید
        </button>
    </div>
    <div class="card-body">

        @if (ViewBag.ErrorMessage != null)
        {
            <script>toastr.error('@ViewBag.ErrorMessage');</script>
        }
        @if (ViewBag.SuccessMessage != null)
        {
            <script>toastr.success('@ViewBag.SuccessMessage');</script>
        }

        <div class="table-responsive">  
            <table id="cartableTable" class="table table-bordered text-nowrap">
                <thead>
                    <tr>
                        <th>شماره درخواست</th>
                        <th>تاریخ ایجاد</th>
                        <th>کد ملی</th>
                        <th>شماره همراه</th>
                        <th>شناسه سند</th>
                        <th>رمز تصدیق</th>
                        <th>شماره قبض انبار</th>
                        <th>گروه/شرکت</th>
                        <th>احراز هویت متقاضی</th>
                        <th>احراز اصالت سند</th>
                        <th>ارتباط متقاضی با سند</th>
                        <th>احراز وکالت</th>
                        <th>نمایش سند</th>
                        <th>قبض انبار</th>
                        <th>تخصیص</th>
                        <th>تایید درخواست</th>
                        <th>تاریخچه</th>
                    </tr>
                </thead>
                <tbody id="cartableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr data-request-id="@item.RequestId">
                            <td>@item.RequestId</td>
                            <td>
                                <div>@item.CreatedAt.ToPersianTime()</div>
                                <small class="text-muted">@item.CreatedAt.ToPersianDate()</small>
                            </td>
                            <td>@item.NationalId</td>
                            <td>@item.MobileNumber</td>
                            <td>@item.DocumentNumber</td>
                            <td>@item.VerificationCode</td>
                            <td>@(string.IsNullOrEmpty(item.WarehouseReceiptNumber) ? "—" : item.WarehouseReceiptNumber)</td>
                            <td>@(string.IsNullOrEmpty(item.GroupTitle) ? "—" : item.GroupTitle)</td>

                            <!-- احراز هویت متقاضی -->
                            <td class="text-center">
                                @if (item.IsMatch == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsMatch == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- احراز اصالت سند -->
                            <td class="text-center">
                                @if (item.IsExist == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="وجود دارد"></i>
                                }
                                else if (item.IsExist == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="وجود ندارد"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- ارتباط متقاضی با سند -->
                            <td class="text-center">
                                @if (item.IsNationalIdInResponse == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsNationalIdInResponse == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- احراز وکالت -->
                            <td class="text-center">
                                @if (item.IsNationalIdInLawyers == true)
                                {
                                    <i class="ri-check-line text-success fs-18" title="تایید شده"></i>
                                }
                                else if (item.IsNationalIdInLawyers == false)
                                {
                                    <i class="ri-close-line text-danger fs-18" title="تایید نشده"></i>
                                }
                                else
                                {
                                    <span class="text-muted">نامشخص</span>
                                }
                            </td>

                            <!-- نمایش سند -->
                            <td class="text-center">
                                <button class="btn btn-sm btn-light btn-view-doc" data-request-id="@item.RequestId" title="مشاهده متن سند">
                                    <i class="ri-file-text-line @(item.IsRead ? "text-success" : "text-primary")"></i>
                                </button>
                            </td>

                            <!-- نمایش قبض انبار -->
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.WarehouseReceiptNumber))
                                {
                                    <button class="btn btn-sm btn-light btn-view-warehouse-receipt" data-request-id="@item.RequestId" title="مشاهده قبض انبار">
                                        <i class="ri-archive-line text-primary"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- تخصیص: کارشناسی که این درخواست رو take کرده -->
                            <td class="text-center">
                                @if (item.ValidateByExpert == false)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="این درخواست به‌صورت سیستمی رد شده؛ دیگه قابل take نیست">
                                        <i class="ri-hand-coin-line me-1"></i> Take
                                    </button>
                                }
                                else if (item.AssignedTo == null)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary take-btn"
                                            data-request-id="@item.RequestId">
                                        <i class="ri-hand-coin-line me-1"></i> Take
                                    </button>
                                }
                                else if (item.AssignedTo?.ToString() == currentUserId)
                                {
                                    <span class="badge bg-primary-transparent">مال شماست</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark" title="این درخواست توسط کارشناس دیگری take شده">
                                        @item.AssignedToName
                                    </span>
                                }
                            </td>

                            <!-- تایید — رد کاملاً سیستمیه و متصدی اکشن دستی براش نداره -->
                            <td class="text-center validation-cell">
                                @if (item.ValidateByExpert == false)
                                {
                                    <span class="badge bg-danger">رد شده (سیستمی)</span>
                                }
                                else if (item.ValidateByExpert == true)
                                {
                                    <span class="badge bg-success">تایید شده</span>
                                }
                                else if (item.IsMatch == true && item.IsExist == true && item.IsNationalIdInResponse == true && item.IsNationalIdInLawyers == true && item.AssignedTo?.ToString() == currentUserId)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success approve-btn"
                                            data-request-id="@item.RequestId">
                                        تایید
                                    </button>
                                }
                                else if (item.IsMatch == true && item.IsExist == true && item.IsNationalIdInResponse == true && item.IsNationalIdInLawyers == true)
                                {
                                    <span class="text-muted small">ابتدا take کنید</span>
                                }
                                else
                                {
                                    <span class="text-muted small">در انتظار تکمیل احراز</span>
                                }

                                @if (item.ValidateByExpert == false && !string.IsNullOrEmpty(item.RejectReasonDisplay))
                                {
                                    <div class="mt-1">
                                        <small class="text-danger reject-reason-text"
                                               style="cursor:pointer; text-decoration:underline dotted;"
                                               data-reason="@item.RejectReasonDisplay"
                                               title="@item.RejectReasonDisplay">
                                            @(item.RejectReasonDisplay.Length > 40 ? item.RejectReasonDisplay.Substring(0, 40) + "..." : item.RejectReasonDisplay)
                                        </small>
                                    </div>
                                }
                            </td>

                            <!-- تاریخچه: کی ایجاد کرد، کی take کرد، تایید/رد دستی یا سیستمی بود -->
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-light btn-view-history" data-request-id="@item.RequestId" title="مشاهده تاریخچه">
                                    <i class="ri-history-line text-primary"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- صفحه‌بندی -->
        <nav class="pagination-style-1 mt-3">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">
                        <i class="ri-arrow-right-s-line"></i>
                    </a>
                </li>

                @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchQuery, filterStatus = ViewBag.FilterStatus })">
                        <i class="ri-arrow-left-s-line"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- ==================== مودال‌ها ==================== -->
<!-- مودال دلیل رد -->
<div class="modal fade" id="rejectReasonModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">دلیل عدم تایید</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="rejectReasonText" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال تاریخچه‌ی درخواست -->
<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تاریخچه‌ی درخواست</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="historyModalBody">
                <div class="text-center text-muted py-5">در حال بارگذاری...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال نمایش سند -->
<div class="modal fade" id="documentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentModalLabel">متن سند</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="documentModalBody">
                <div class="text-center text-muted py-5">در حال بارگذاری...</div>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="documentChecked">
                    <label class="form-check-label" for="documentChecked">متن سند بررسی شد</label>
                </div>
                <button type="button" class="btn btn-success" id="confirmDocument">تایید</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال نمایش قبض انبار -->
<div class="modal fade" id="warehouseReceiptModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="warehouseReceiptModalLabel">قبض انبار</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="warehouseReceiptModalBody">
                <div class="text-center text-muted py-5">در حال بارگذاری...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد درخواست جدید -->
<div class="modal fade" id="scrollingmodal" tabindex="-1" aria-labelledby="scrollingmodalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="scrollingmodalLabel">ایجاد درخواست جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>

            <div class="modal-body p-4">
                <form asp-action="ValidateSteps" method="post" id="needs-validation-form" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- بخش اطلاعات متقاضی -->
                    <div class="mb-4">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-user-line me-1"></i>
                            اطلاعات متقاضی
                        </p>

                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="NationalCode" class="form-label text-default">کد ملی</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="NationalCode"
                                       name="NationalCode"
                                       placeholder="کد ملی ۱۰ رقمی"
                                       maxlength="10"
                                       inputmode="numeric"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="MobileNumber" class="form-label text-default">شماره موبایل</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="MobileNumber"
                                       name="MobileNumber"
                                       placeholder="09xxxxxxxxx"
                                       maxlength="11"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>

                        <!-- دکمه ارسال کد دو عاملی -->
                        <div class="mt-3">
                            <button type="button" id="btnSendOtp" class="btn btn-outline-primary btn-sm">
                                <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                            </button>
                            <span id="otpTimer" class="text-muted ms-2" style="display:none;"></span>
                        </div>

                        <!-- فیلد کد دو عاملی -->
                        <div class="row gy-3 mt-2" id="otpSection" style="display:none;">
                            <div class="col-md-6">
                                <label for="OtpCode" class="form-label text-default">کد تایید پیامکی</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="OtpCode"
                                       name="OtpCode"
                                       placeholder="کد ۶ رقمی"
                                       maxlength="6"
                                       inputmode="numeric" />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="button" id="btnVerifyOtp" class="btn btn-success btn-sm">
                                    تایید کد
                                </button>
                            </div>
                        </div>

                        <div id="otpMessage" class="mt-2"></div>

                        @if (!string.IsNullOrEmpty(formModel?.Step1Message))
                        {
                            <div class="mt-2">
                                <small class="text-@(formModel.Step1Message.Contains("معتبر") ? "success" : "danger")">
                                    @formModel.Step1Message
                                </small>
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <!-- بخش اطلاعات سند -->
                    <div class="mb-2">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-file-text-line me-1"></i>
                            اطلاعات سند
                        </p>

                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="DocumentNumber" class="form-label text-default">شناسه سند</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="DocumentNumber"
                                       name="DocumentNumber"
                                       placeholder="شناسه سند را وارد کنید"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="VerifyCode" class="form-label text-default">رمز تصدیق</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="VerifyCode"
                                       name="VerifyCode"
                                       placeholder="رمز تصدیق را وارد کنید"
                                       required />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formModel?.Step2Message))
                        {
                            <div class="mt-2">
                                <small class="text-@(formModel.Step2Message.Contains("معتبر") ? "success" : "danger")">
                                    @formModel.Step2Message
                                </small>
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <!-- بخش قبض انبار -->
                    <div class="mb-2">
                        <p class="fw-semibold mb-3 text-primary">
                            <i class="ri-archive-line me-1"></i>
                            قبض انبار
                        </p>

                        <div class="row gy-3">
                            <div class="col-md-6">
                                <label for="WarehouseReceiptNumber" class="form-label text-default">شماره قبض انبار</label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="WarehouseReceiptNumber"
                                       name="WarehouseReceiptNumber"
                                       placeholder="شماره قبض انبار را وارد کنید"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label for="CompanyId" class="form-label text-default">شرکت مربوط به قبض انبار</label>
                                <select class="form-control form-control-lg" id="CompanyId" name="CompanyId" required>
                                    <option value="">انتخاب کنید...</option>
                                    @foreach (var company in companies)
                                    {
                                        <option value="@company.CompanyId">@company.CompanyName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" form="needs-validation-form" id="btnVerify" class="btn btn-primary" disabled>
                    ثبت درخواست
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/persianDatepicker.min.js"></script>
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
    <script>
        $(document).ready(function () {
            // مخفی کردن لودر (اگر هنوز مونده باشه)
            $("#global-loader").fadeOut("slow");

            // دراپ‌داون‌های استاندارد یزن به‌جای select خام مرورگر
            if (typeof Choices !== 'undefined') {
                new Choices('#filterStatus', { searchEnabled: false, shouldSort: false, itemSelectText: '' });

                // #CompanyId داخل مودالیه که پیش‌فرض مخفیه؛ باید بعد از باز شدن مودال init بشه
                // وگرنه Choices.js عرض/موقعیت درست رو محاسبه نمی‌کنه
                var companyChoices = null;
                $('#scrollingmodal').on('shown.bs.modal', function () {
                    if (!companyChoices && document.getElementById('CompanyId')) {
                        companyChoices = new Choices('#CompanyId', { searchEnabled: true, shouldSort: false, itemSelectText: '', placeholder: true });
                    }
                });
                $('#scrollingmodal').on('hidden.bs.modal', function () {
                    if (companyChoices) companyChoices.setChoiceByValue('');
                });
            }

            // فیلتر بازه‌ی تاریخ (کارتابل کارشناس) — تقویم فارسی روی فیلدهای نمایشی،
            // مقدار میلادی معادل (data-gDate که خودِ پلاگین محاسبه می‌کنه) موقع submit تو فیلد hidden می‌ره.
            try {
                $('.jalali-date-input').persianDatepicker({ formatDate: 'YYYY/MM/DD' });
            } catch (e) {
                console.warn('persianDatepicker init failed, falling back to plain text inputs', e);
            }

            $('#cartableFilterForm').on('submit', function () {
                $('#fromDateHidden').val($('#fromDateDisplay').attr('data-gDate') || $('#fromDateHidden').val());
                $('#toDateHidden').val($('#toDateDisplay').attr('data-gDate') || $('#toDateHidden').val());
            });

            // وضعیت تایید دو عاملی برای فرم «سند جدید»
            let otpVerified = false;
            let otpTimerInterval = null;
            let remainingSeconds = 0;

            // ریست فرم مودال
            $('#scrollingmodal').on('hidden.bs.modal', function () {
                $('#needs-validation-form')[0].reset();
                otpVerified = false;
                $('#otpSection').hide();
                $('#otpMessage').html('');
                $('#btnVerify').prop('disabled', true);
                $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                clearInterval(otpTimerInterval);
                $('#otpTimer').hide();
            });

            // ارسال کد OTP
            $('#btnSendOtp').click(function () {
                const nationalCode = $('#NationalCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!nationalCode || nationalCode.length !== 10) {
                    toastr.warning('کد ملی را به درستی وارد کنید');
                    return;
                }
                if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                    toastr.warning('شماره موبایل را به درستی وارد کنید');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال بررسی احراز هویت...');

                // اول شاهکار چک می‌شه — اگه تطابق نداشت، اصلاً کد OTP ارسال نمی‌شه
                $.post('/Cartable/CheckShahkar', {
                    nationalCode: nationalCode,
                    mobileNumber: mobile
                })
                .done(function (checkRes) {
                    if (!checkRes.success) {
                        toastr.error(checkRes.message || 'خطا در احراز هویت');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }
                    if (!checkRes.isMatch) {
                        toastr.error('کد ملی و شماره موبایل تطابق ندارند');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }

                    btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال کد...');

                    $.post('/Cartable/SendOtp', {
                        nationalCode: nationalCode,
                        mobileNumber: mobile
                    })
                    .done(function (res) {
                        if (res.success) {
                            toastr.success(res.message || 'کد تایید ارسال شد');
                            if (res.debugOtp) {
                                toastr.info('کد تست: ' + res.debugOtp);
                            }
                            $('#otpSection').slideDown();
                            startOtpTimer(120);
                        } else {
                            toastr.error(res.message || 'خطا در ارسال کد');
                        }
                    })
                    .fail(function () {
                        toastr.error('خطا در ارتباط با سرور');
                    })
                    .always(function () {
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                    });
                })
                .fail(function () {
                    toastr.error('خطا در ارتباط با سرور');
                    btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                });
            });

            // تایید کد OTP
            $('#btnVerifyOtp').click(function () {
                const otp = $('#OtpCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!otp || otp.length !== 6) {
                    toastr.warning('کد ۶ رقمی را وارد کنید');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', {
                    mobileNumber: mobile,
                    otpCode: otp
                })
                .done(function (res) {
                    if (res.success) {
                        otpVerified = true;
                        $('#otpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                        $('#btnVerify').prop('disabled', false);
                        $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', true);
                        toastr.success('کد تایید صحیح است');
                    } else {
                        $('#otpMessage').html('<small class="text-danger">' + (res.message || 'کد اشتباه است') + '</small>');
                        toastr.error(res.message || 'کد اشتباه است');
                        btn.prop('disabled', false).html('تایید کد');
                    }
                })
                .fail(function () {
                    toastr.error('خطا در ارتباط با سرور');
                    btn.prop('disabled', false).html('تایید کد');
                });
            });

            // تایمر OTP
            function startOtpTimer(seconds) {
                remainingSeconds = seconds;
                $('#otpTimer').show();
                clearInterval(otpTimerInterval);

                otpTimerInterval = setInterval(function () {
                    remainingSeconds--;
                    const min = Math.floor(remainingSeconds / 60);
                    const sec = remainingSeconds % 60;
                    $('#otpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (remainingSeconds <= 0) {
                        clearInterval(otpTimerInterval);
                        $('#otpTimer').hide();
                        $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال مجدد کد');
                    }
                }, 1000);
            }

            // نمایش متن سند
            $(document).on('click', '.btn-view-doc', function () {
                const requestId = $(this).data('request-id');
                $('#documentModalLabel').text('متن سند درخواست ' + requestId);
                $('#documentModalBody').html('<div class="text-center py-5"><div class="spinner-border"></div><div class="mt-2">در حال بارگذاری...</div></div>');
                $('#documentChecked').prop('checked', false).prop('disabled', false);
                $('#confirmDocument').data('request-id', requestId).prop('disabled', false);
                $('#documentModal').modal('show');

                $.get('/Cartable/GetDocumentText', { requestId: requestId })
                    .done(function (res) {
                        if (res?.success && res.documentText?.trim()) {
                            let safe = $('<div/>').text(res.documentText).html();
                            safe = safe.replace(
                                /(مهلت اعتبار این وکالتنامه تا تاریخ\s*\d{4}\/\d{2}\/\d{2}\s*می باشد)/g,
                                '<strong class="text-danger">$1</strong>'
                            );
                            $('#documentModalBody').html('<pre class="document-content" style="white-space:pre-wrap;line-height:1.8;background:#f8f9fa;padding:1rem;border-radius:8px;">' + safe + '</pre>');
                            $('#documentChecked').prop('checked', res.isRead === true);
                        } else {
                            $('#documentModalBody').html('<p class="text-danger text-center py-4">رمز تصدیق یا شماره سند صحیح نیست.</p>');
                            $('#documentChecked, #confirmDocument').prop('disabled', true);
                            toastr.error(res?.message || 'اطلاعات سند صحیح نیست');
                        }
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.message || 'خطا در دریافت سند';
                        $('#documentModalBody').html('<p class="text-danger text-center py-4">' + msg + '</p>');
                        $('#documentChecked, #confirmDocument').prop('disabled', true);
                        toastr.error(msg);
                    });
            });

            // نمایش تاریخچه‌ی درخواست
            $(document).on('click', '.btn-view-history', function () {
                const requestId = $(this).data('request-id');
                $('#historyModalBody').html('<div class="text-center py-5"><div class="spinner-border"></div><div class="mt-2">در حال بارگذاری...</div></div>');
                $('#historyModal').modal('show');

                $.get('/Cartable/RequestHistory', { id: requestId })
                    .done(function (res) {
                        if (!Array.isArray(res) || res.length === 0) {
                            $('#historyModalBody').html('<p class="text-muted text-center py-4">تاریخچه‌ای ثبت نشده است.</p>');
                            return;
                        }

                        let html = '<ul class="list-group list-group-flush">';
                        res.forEach(function (h) {
                            const actorBadge = h.isSystemAction
                                ? '<span class="badge bg-secondary">سیستم</span>'
                                : '<span class="badge bg-primary-transparent">' + $('<div/>').text(h.updatedStatusBy || 'نامشخص').html() + '</span>';
                            const dateStr = new Date(h.createdAt).toLocaleString('fa-IR');
                            html += '<li class="list-group-item">';
                            html += '<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">';
                            html += '<div>' + actorBadge + ' <span class="fw-semibold ms-1">' + $('<div/>').text(h.updatedStatus || h.statusName || '').html() + '</span></div>';
                            html += '<small class="text-muted">' + dateStr + '</small>';
                            html += '</div>';
                            if (h.actionDescription) {
                                html += '<div class="mt-1 small text-muted">' + $('<div/>').text(h.actionDescription).html() + '</div>';
                            }
                            html += '</li>';
                        });
                        html += '</ul>';
                        $('#historyModalBody').html(html);
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.message || 'خطا در دریافت تاریخچه';
                        $('#historyModalBody').html('<p class="text-danger text-center py-4">' + msg + '</p>');
                        toastr.error(msg);
                    });
            });

            // نمایش متن قبض انبار
            $(document).on('click', '.btn-view-warehouse-receipt', function () {
                const requestId = $(this).data('request-id');
                $('#warehouseReceiptModalLabel').text('قبض انبار درخواست ' + requestId);
                $('#warehouseReceiptModalBody').html('<div class="text-center py-5"><div class="spinner-border"></div><div class="mt-2">در حال بارگذاری...</div></div>');
                $('#warehouseReceiptModal').modal('show');

                $.get('/Cartable/GetWarehouseReceiptText', { requestId: requestId })
                    .done(function (res) {
                        if (res?.success && res.text?.trim()) {
                            const safe = $('<div/>').text(res.text).html();
                            $('#warehouseReceiptModalBody').html('<pre style="white-space:pre-wrap;line-height:1.8;background:#f8f9fa;padding:1rem;border-radius:8px;">' + safe + '</pre>');
                        } else {
                            $('#warehouseReceiptModalBody').html('<p class="text-danger text-center py-4">' + (res?.message || 'اطلاعاتی برای این قبض انبار یافت نشد.') + '</p>');
                        }
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.message || 'خطا در دریافت قبض انبار';
                        $('#warehouseReceiptModalBody').html('<p class="text-danger text-center py-4">' + msg + '</p>');
                    });
            });

            // تایید خواندن سند
            $('#confirmDocument').click(function () {
                if (!$('#documentChecked').is(':checked')) {
                    toastr.warning('لطفاً گزینه «متن سند بررسی شد» را تیک بزنید');
                    return;
                }
                const requestId = $(this).data('request-id');
                $.post('/Cartable/MarkDocumentAsRead', { requestId: requestId })
                    .done(function (res) {
                        if (res.success) {
                            toastr.success('سند به عنوان خوانده‌شده ثبت شد');
                            $('#documentModal').modal('hide');
                        } else {
                            toastr.error(res.message || 'خطا در ثبت');
                        }
                    })
                    .fail(() => toastr.error('خطا در ارتباط با سرور'));
            });

            // دکمه تایید — رد کاملاً سیستمیه، متصدی فقط می‌تونه تایید بزنه
            $(document).on('click', '.approve-btn', function () {
                submitValidation($(this).data('request-id'), true, null);
            });

            // دکمه Take — کارشناس درخواست رو از صف مشترک گروهش برمی‌داره
            $(document).on('click', '.take-btn', function () {
                const btn = $(this);
                const requestId = btn.data('request-id');
                const row = $(`tr[data-request-id="${requestId}"]`);
                const token = $('input[name="__RequestVerificationToken"]').val();

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                fetch('/Cartable/TakeRequest?requestId=' + requestId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success(data.message || 'درخواست take شد');
                            row.find('.take-btn').replaceWith('<span class="badge bg-primary-transparent">مال شماست</span>');
                            row.find('.validation-cell').html(
                                '<button type="button" class="btn btn-sm btn-outline-success approve-btn" data-request-id="' + requestId + '">تایید</button>'
                            );
                        } else {
                            toastr.error(data.message || 'خطا در take کردن درخواست');
                            btn.prop('disabled', false).html('<i class="ri-hand-coin-line me-1"></i> Take');
                        }
                    })
                    .catch(() => {
                        toastr.error('خطا در ارتباط با سرور');
                        btn.prop('disabled', false).html('<i class="ri-hand-coin-line me-1"></i> Take');
                    });
            });

            // نمایش دلیل رد سیستمی
            $(document).on('click', '.reject-reason-text', function () {
                $('#rejectReasonText').text($(this).data('reason') || 'دلیلی ثبت نشده');
                $('#rejectReasonModal').modal('show');
            });

            function submitValidation(requestId, validateByExpert, description) {
                const row = $(`tr[data-request-id="${requestId}"]`);
                const token = $('input[name="__RequestVerificationToken"]').val();
                fetch('/Cartable/UpdateValidationStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        RequestId: requestId,
                        ValidateByExpert: validateByExpert,
                        Description: description
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        toastr.success(data.message || "وضعیت به‌روز شد");
                        row.find('.approve-btn').replaceWith('<span class="badge bg-success">تایید شده</span>');
                    } else {
                        toastr.error(data.message || "خطا");
                    }
                })
                .catch(() => toastr.error("خطا در ارتباط با سرور"));
            }

            // فرم درخواست جدید
            $('#needs-validation-form').on('submit', function (e) {
                e.preventDefault();

                if (!otpVerified) {
                    toastr.error('لطفاً ابتدا کد تایید پیامکی را وارد و تایید کنید');
                    return;
                }

                const btn = $('#btnVerify');
                if (!this.checkValidity()) {
                    toastr.error('لطفاً فیلدهای الزامی را پر کنید');
                    return;
                }
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done((data) => {
                        if (data && data.success) {
                            toastr.success(data.message || 'درخواست با موفقیت ثبت شد');
                            $('#scrollingmodal').modal('hide');
                            // اجازه می‌دیم توست قبل از رفرش صفحه دیده بشه
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error((data && data.message) || 'اطلاعات وارد شده معتبر نیست.');
                            btn.prop('disabled', false).html('ثبت درخواست');
                        }
                    })
                    .fail((xhr) => {
                        toastr.error(xhr.responseJSON?.message || 'خطا در ارسال درخواست');
                        btn.prop('disabled', false).html('ثبت درخواست');
                    });
            });
        });
    </script>
}