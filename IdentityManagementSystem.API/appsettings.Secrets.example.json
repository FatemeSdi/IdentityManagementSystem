  // ApiKey باید با ApiSettings:ApiKey تو appsettings.Secrets.json پروژه‌های UI و PublicPortal یکی باشه.
  "ApiKey": "<یک رشته‌ی تصادفی طولانی، مثلاً 32 بایت base64>",
