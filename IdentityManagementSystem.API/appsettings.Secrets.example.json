    "Key": "<کلید امضای JWT — حداقل 32 کاراکتر؛ برای Production مقدار جدید بسازید>"
  },
  "Encryption": {
    // هشدار: این دو کلید باید دقیقاً همون مقداری باشن که داده‌های فعلی دیتابیس باهاش رمز شدن؛ عوضشون نکنید.
    "Key": "<base64 کلید AES>",
    "HmacKey": "<base64 کلید HMAC>"
  },
  "Shahkar": {
    "Credential": {
      "Code": "<کد سرویس‌گیرنده‌ی شاهکار>",
      "Password": "<رمز شاهکار>"
    }
  },
  "Bsr": {
    "Username": "<نام کاربری bsr>",
    "Password": "<رمز bsr>"
  }
