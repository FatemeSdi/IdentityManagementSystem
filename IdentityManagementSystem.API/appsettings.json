{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-81PQ5CN;Database=IdentityManagementSystem;Trusted_Connection=True;TrustServerCertificate=True;App=Identity"
    // "DefaultConnection": "Server=DESKTOP-5F4L43S;Database=IdentityManagementSystem;Trusted_Connection=True;TrustServerCertificate=True;"
    // "DefaultConnection": "Server=MASOUD\\MSSQL2022;Database=IdentityManagementSystem;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  // رمزها و کلیدها (ApiKey، Jwt:Key، Encryption، اعتبارنامه‌ی Shahkar و Bsr) اینجا نیستن —
  // تو appsettings.Secrets.json (خارج از گیت) هستن؛ ساختارش: appsettings.Secrets.example.json
  "Jwt": {
    "Issuer": "IdentityManagementSystem",
    "Audience": "IdentityManagementSystem",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Shahkar": {
    "BaseUrl": "https://core.pomix.pmo.ir/api"
  },
  "Gateway": {
    // حالت‌هایی که API قبول می‌کنه (بدون restart قابل تغییره):
    //   Pomix         = هندلرها از طریق Gateway سازمان (اگه DirectGateway نباشه، فقط از IP های PomixSourceIps)
    //   DirectGateway = هندلرها مستقیم از هر جا (با X-API-Key معتبر)
    //   DirectApi     = همه‌ی اندپوینت‌های مستقیم (/api/Auth/login و ...) — بدونش 404 می‌دن
    // جدا با کاما؛ یک یا چند حالت. این تنها جاییه که تنظیم می‌شه (تو appsettings.Production.json تکرار نکنید وگرنه این رو override می‌کنه).
    //   حالت عادی سرور:  "Pomix, DirectGateway"
    //   شرایط اضطراری:   "Pomix"  (و PomixSourceIps رو پر کنید)
    //   عیب‌یابی داخلی:  "Pomix, DirectGateway, DirectApi"
    "AllowedModes": "Pomix, DirectGateway",
    // IP سرور(های) Gateway سازمان که به API وصل می‌شن، جدا با کاما (IP واقعی اتصال، نه X-Forwarded-For)
    "PomixSourceIps": ""
  },
  "Sms": {
    "BaseUrl": "http://10.2.79.10:8083/api/SMSProvider",
    "AppName": "IDMS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // فقط برای وقتیه که مرورگر مستقیم API رو صدا بزنه؛ UI/PublicPortal سرور-به-سرور وصل می‌شن و بهش نیاز ندارن.
    // بدون restart قابل تغییره. false = هیچ سایتی مجاز نیست (امن‌ترین حالت). در appsettings.Production.json تکرار نکنید.
    "Enabled": true,
    // آدرس‌های مجاز، جدا با کاما (Enabled = true با لیست خالی هم یعنی هیچ سایتی مجاز نیست)
    "AllowedOrigins": "https://localhost:7031, http://localhost:5031"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5066"
      }
    }
  }
}

