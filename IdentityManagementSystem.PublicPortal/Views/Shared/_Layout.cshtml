<!DOCTYPE html>
<html dir="rtl" data-header-styles="light" data-menu-styles="light" data-nav-layout="vertical" data-theme-mode="light" data-toggled="close" data-vertical-style="overlay" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه احراز اصالت سند و قبض انبار</title>

    <link rel="icon" href="~/assets/images/brand-logos/favicon.ico" type="image/x-icon" />

    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/vazir-font.css" rel="stylesheet" />
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />

    <style>
        :root {
            --primary-rgb: 27, 66, 117;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .footer {
            margin-top: auto;
        }

        .small, small {
            font-size: 0.8125rem;
        }

        /* هدر ساده و خودکفا — این پروژه سایدبار نداره و کلاس‌های .app-header/.main-header-container
           یزن برای شل ادمین با ارتفاع ثابت طراحی شدن؛ برای هدر دو-خطی این پروژه مناسب نیستن
           (باعث شکستن دکمه‌ها به خط بعد می‌شدن)، پس هدر مستقل با ارتفاع خودکار ساخته شده. */
        .portal-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #fff;
            border-bottom: 1px solid var(--default-border, #e9edf1);
            box-shadow: 0 4px 16px rgba(118, 200, 254, .03);
        }
    </style>
</head>
<body>
    <header class="portal-header">
        <div class="container-fluid px-0 d-flex align-items-center justify-content-between flex-wrap">
            <a href="@Url.Action("ClientIndex", "Cartable")" class="d-flex align-items-center gap-2 text-decoration-none py-2 ps-3 ps-lg-4">
                <img src="~/assets/images/brand-logos/logo-pmo.png" alt="سازمان بنادر و دریانوردی" style="height:44px;width:auto;" onerror="this.style.display='none'" />
                <span>
                    <span class="d-block fs-15 fw-bold text-default">سازمان بنادر و دریانوردی</span>
                    <span class="d-none d-sm-block fs-13 text-muted">سامانه احراز اصالت سند و قبض انبار</span>
                </span>
            </a>
            <div class="dropdown py-2 pe-3 pe-lg-4">
                <a href="javascript:void(0);" class="btn btn-sm btn-primary-light dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="ri-apps-2-line"></i><span class="d-none d-sm-inline"> خدمات</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item js-show-new-request" href="javascript:void(0);">
                            <i class="ri-archive-line me-2"></i>قبض انبار
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="footer mt-auto py-3 bg-white text-center">
        <div class="container">
            <span class="text-muted">
                <span id="year"></span>
                <a class="text-dark fw-medium" href="javascript:void(0);">اداره کل بنادر و دریانوردی هرمزگان</a>
                — طراحی و توسعه توسط
                <a href="javascript:void(0);"><span class="fw-medium text-primary">تیم فناوری اطلاعات</span></a>
                — تمام حقوق محفوظ است
                <span class="mx-2">|</span>
                <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#supportModal" class="text-muted">
                    <i class="ri-phone-line me-1"></i>تماس با ما
                </a>
            </span>
        </div>
    </footer>

    <div class="modal fade" id="supportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="ri-headphone-line me-2"></i>پشتیبانی</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-phone-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">فاوا — نرم‌افزار (ساعات اداری)</div>
                            <div class="fw-semibold" style="direction:ltr;text-align:right;">۰۹۹۴۰۶۵۷۷۵۳ — فاطمه صادقی</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-phone-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">داخلی</div>
                            <div class="fw-semibold" style="direction:ltr;text-align:right;">۴۶۴۷</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-mail-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">ایمیل</div>
                            <div class="fw-semibold">sdi10fateme@@gmail.com</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>

    <script>
        window.showToast = function (message, type = "info") {
            let backgroundColor = "#5477f5";
            if (type === "success") backgroundColor = "#28a745";
            if (type === "error") backgroundColor = "#dc3545";
            if (type === "warning") backgroundColor = "#ffc107";

            Toastify({
                text: message,
                duration: 4000,
                gravity: "top",
                position: "left",
                style: { background: backgroundColor },
                close: true
            }).showToast();
        };

        document.addEventListener('DOMContentLoaded', function () {
            var yearEl = document.getElementById('year');
            if (yearEl) {
                yearEl.textContent = new Date().toLocaleDateString('fa-IR', { year: 'numeric' });
            }

            // نمایش بخش «ثبت درخواست جدید» با کلیک روی «قبض انبار» در دراپ‌داون خدمات
            // (این بخش با d-none پیش‌فرض مخفیه — رجوع کن به ClientIndex.cshtml)
            document.querySelectorAll('.js-show-new-request').forEach(function (link) {
                link.addEventListener('click', function () {
                    var section = document.getElementById('newRequestSection');
                    if (!section) return;
                    section.classList.remove('d-none');
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
