<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه احراز اصالت سند و قبض انبار</title>

    <link rel="icon" href="~/assets/images/brand-logos/favicon.ico" type="image/x-icon" />

    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-rgb: 27, 66, 117;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .footer {
            margin-top: auto;
        }

        /* متن‌های فرعی (غیر تیتر) کمی بزرگ‌تر و خواناتر */
        .small, small {
            font-size: 0.8125rem;
        }
    </style>
</head>
<body>
    <header class="app-header sticky-top">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3 px-lg-4">
            <a href="@Url.Action("ClientIndex", "Cartable")" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="~/assets/images/brand-logos/logo-pmo.png" alt="سازمان بنادر و دریانوردی" style="height:44px;width:auto;" onerror="this.style.display='none'" />
                <span>
                    <span class="d-block fs-15 fw-bold text-default">سازمان بنادر و دریانوردی</span>
                    <span class="d-none d-sm-block fs-13 text-muted">سامانه احراز اصالت سند و قبض انبار</span>
                </span>
            </a>
            <nav class="d-flex align-items-center gap-1">
                <div class="dropdown">
                    <a href="javascript:void(0);" class="btn btn-sm btn-primary-light dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="ri-apps-2-line"></i><span class="d-none d-sm-inline"> خدمات</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("ClientIndex", "Cartable")#trackSection">
                                <i class="ri-archive-line me-2"></i>قبض انبار
                            </a>
                        </li>
                    </ul>
                </div>
                <a href="#trackSection" class="btn btn-sm btn-primary-light">
                    <i class="ri-search-eye-line"></i><span class="d-none d-sm-inline"> پیگیری درخواست</span>
                </a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="footer py-3 border-top">
        <div class="container-fluid px-3 px-lg-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="mb-0 fs-13 text-muted">کلیه حقوق این سامانه متعلق به سازمان بنادر و دریانوردی می‌باشد.</p>
            <div class="d-flex gap-3">
                <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#supportModal" class="fs-13 text-muted text-decoration-none">
                    <i class="ri-phone-line me-1"></i>تماس با ما
                </a>
                <a href="#" class="fs-13 text-muted text-decoration-none"><i class="ri-book-open-line me-1"></i>راهنما</a>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="supportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="ri-headphone-line me-2"></i>پشتیبانی</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-phone-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">فاوا — نرم‌افزار (ساعات اداری)</div>
                            <div class="fw-semibold" style="direction:ltr;text-align:right;">۰۹۹۴۰۶۵۷۷۵۳ — فاطمه صادقی</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-phone-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">داخلی</div>
                            <div class="fw-semibold" style="direction:ltr;text-align:right;">۴۶۴۷</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-mail-line"></i></span>
                        <div>
                            <div class="fs-13 text-muted">ایمیل</div>
                            <div class="fw-semibold">sdi10fateme@@gmail.com</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>

    <script>
        window.showToast = function (message, type = "info") {
            let backgroundColor = "#5477f5";
            if (type === "success") backgroundColor = "#28a745";
            if (type === "error") backgroundColor = "#dc3545";
            if (type === "warning") backgroundColor = "#ffc107";

            Toastify({
                text: message,
                duration: 4000,
                gravity: "top",
                position: "left",
                style: { background: backgroundColor },
                close: true
            }).showToast();
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
