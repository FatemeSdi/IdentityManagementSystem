@using IdentityManagementSystem.PublicPortal.Controllers
@{
    ViewData["Title"] = "ثبت درخواست";
    string? trackMobile = ViewBag.TrackMobile as string;
    bool trackOtpVerified = ViewBag.TrackOtpVerified is bool b && b;
    var pendingRequests = ViewBag.PendingRequests as List<PendingRequestItem>;
    var companies = ViewBag.Companies as List<CompanyOption> ?? new List<CompanyOption>();
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #eef2f8 0%, #e4ebf5 55%, #f2f5f9 100%);
        padding: 40px 0 32px;
        overflow: hidden;
    }

    .hero-section h2 {
        color: var(--primary-color);
        font-weight: 700;
        font-size: 28px;
        margin-bottom: 10px;
    }

    .hero-section > .container > .row > div p.lead {
        color: #4d5b72;
        font-size: 14.5px;
        margin-bottom: 22px;
    }

    .hero-illustration {
        width: 100%;
        max-width: 380px;
        margin: 0 auto;
        display: block;
    }

    .portal-main {
        padding: 28px 0 48px;
    }

    /* ---------- ویزارد مرحله‌ای ---------- */
    .step-indicator {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 30px;
        position: relative;
    }

        .step-indicator::before {
            content: "";
            position: absolute;
            top: 17px;
            right: 8%;
            left: 8%;
            height: 2px;
            background: #e6e9ef;
            z-index: 0;
        }

    .step-item {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

    .step-item .step-circle {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 2px solid #dfe4ec;
        color: #9aa5b5;
        font-weight: 700;
        font-size: 14px;
        transition: all .2s ease;
    }

    .step-item .step-label {
        font-size: 12px;
        color: #9aa5b5;
        font-weight: 600;
        text-align: center;
    }

    .step-item.active .step-circle {
        border-color: var(--primary-color);
        background: var(--primary-color);
        color: #fff;
    }

    .step-item.active .step-label {
        color: var(--primary-color);
    }

    .step-item.completed .step-circle {
        border-color: #2b9e6b;
        background: #2b9e6b;
        color: #fff;
    }

    .step-item.completed .step-label {
        color: #2b9e6b;
    }

    .wizard-step {
        display: none;
    }

        .wizard-step.active {
            display: block;
        }

    .wizard-nav {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 22px;
    }

    @@media (max-width: 991px) {
        .hero-illustration {
            max-width: 260px;
        }
    }
</style>

<!-- ==================== هیرو ==================== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <h2>سامانه احراز اصالت سند و قبض انبار</h2>
                <p class="lead">ثبت و پیگیری درخواست مجوز بارگیری از کانتینرها در محوطه‌های اسکله</p>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-2 bg-white rounded p-2 shadow-sm h-100">
                            <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-shield-check-line"></i></span>
                            <div>
                                <b class="d-block fs-12 fw-bold text-default">احراز صریح و امن</b>
                                <span class="fs-11 text-muted">امنیت کامل اطلاعات شما</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-2 bg-white rounded p-2 shadow-sm h-100">
                            <span class="avatar avatar-rounded bg-primary-transparent"><i class="ri-file-list-3-line"></i></span>
                            <div>
                                <b class="d-block fs-12 fw-bold text-default">پیگیری آسان</b>
                                <span class="fs-11 text-muted">با کد پیگیری، وضعیت را ببینید</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <svg class="hero-illustration" viewBox="0 0 480 380" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="240" cy="180" r="170" fill="#dfe8f5" />
                    <rect x="0" y="300" width="480" height="30" fill="#1b4275" opacity="0.12" />
                    <rect x="60" y="240" width="300" height="70" rx="10" fill="#14335e" />
                    <rect x="90" y="200" width="55" height="45" rx="4" fill="#b78a34" />
                    <rect x="150" y="200" width="55" height="45" rx="4" fill="#ffffff" stroke="#dfe4ec" stroke-width="2" />
                    <rect x="210" y="200" width="55" height="45" rx="4" fill="#1b4275" />
                    <rect x="270" y="200" width="55" height="45" rx="4" fill="#b78a34" />
                    <rect x="120" y="160" width="55" height="45" rx="4" fill="#1b4275" />
                    <rect x="180" y="160" width="55" height="45" rx="4" fill="#ffffff" stroke="#dfe4ec" stroke-width="2" />
                    <rect x="240" y="160" width="55" height="45" rx="4" fill="#b78a34" />
                    <rect x="345" y="120" width="10" height="140" fill="#7c8798" />
                    <rect x="300" y="110" width="140" height="12" rx="4" fill="#7c8798" />
                    <rect x="325" y="122" width="6" height="60" fill="#9aa5b5" />
                    <circle cx="328" cy="184" r="5" fill="#b78a34" />
                    <rect x="316" y="184" width="24" height="4" fill="#b78a34" />
                    <rect x="336" y="60" width="16" height="60" rx="3" fill="#14335e" />
                    <rect x="326" y="50" width="36" height="14" rx="3" fill="#14335e" />
                </svg>
            </div>
        </div>
    </div>
</section>

<div class="container portal-main" id="trackSection">
    <!-- پیگیری درخواست با کد پیگیری + شماره موبایل (بدون نیاز به لاگین) -->
    <div class="card custom-card mb-3 w-100">
        <div class="card-header">
            <div class="card-title mb-0">
                <i class="ri-search-eye-line me-1"></i>
                پیگیری درخواست
            </div>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">برای مشاهده وضعیت درخواست قبلی، شماره موبایل و کد پیگیری خود را وارد کنید.</p>
            <form id="trackRequestForm" class="row g-3 align-items-end" method="get" asp-action="ClientIndex">
                <div class="col-md-4">
                    <label for="trackMobileNumber" class="form-label text-default">شماره موبایل</label>
                    <input type="text" class="form-control" name="trackMobile" id="trackMobileNumber" value="@trackMobile" placeholder="مثلاً 09123456789" maxlength="11" inputmode="numeric" required />
                </div>
                <div class="col-md-4">
                    <label for="trackTrackingCode" class="form-label text-default">کد پیگیری (اختیاری)</label>
                    <input type="text" class="form-control" id="trackTrackingCode" placeholder="مثلاً REQ00020198" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-search-line me-1"></i> پیگیری وضعیت
                    </button>
                </div>
            </form>

            <!-- فقط وقتی کد پیگیری خالیه و باید شماره موبایل با OTP تایید بشه نشون داده می‌شه -->
            <div id="trackOtpSection" class="row g-3 align-items-end mt-1" style="@(!string.IsNullOrEmpty(trackMobile) && !trackOtpVerified ? "" : "display:none;")">
                <div class="col-md-4">
                    <button type="button" id="trackBtnSendOtp" class="btn btn-outline-primary btn-sm">
                        <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                    </button>
                    <span id="trackOtpTimer" class="text-muted ms-2" style="display:none;"></span>
                </div>
                <div class="col-md-4">
                    <label for="trackOtpCode" class="form-label text-default">کد تایید پیامکی</label>
                    <input type="text" class="form-control" id="trackOtpCode" placeholder="کد ۶ رقمی" maxlength="6" inputmode="numeric" />
                </div>
                <div class="col-md-4">
                    <button type="button" id="trackBtnVerifyOtp" class="btn btn-success btn-sm">تایید کد</button>
                </div>
            </div>
            <div id="trackOtpMessage" class="mt-2"></div>

            <div id="trackRequestResult" class="mt-3"></div>

            @* --- نتیجه‌ی پیگیری با موبایل: کاملاً سمت کنترلر رندر می‌شه، نه با جاوااسکریپت --- *@
            @if (!string.IsNullOrEmpty(trackMobile) && trackOtpVerified)
            {
                <div class="mt-3">
                    @if (pendingRequests == null || pendingRequests.Count == 0)
                    {
                        <p class="text-muted text-center mb-0">درخواست «در انتظار بررسی»ای برای این شماره یافت نشد.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var item in pendingRequests)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div>
                                        <strong>قبض انبار: @(string.IsNullOrEmpty(item.WarehouseReceiptNumber) ? "—" : item.WarehouseReceiptNumber)</strong>
                                        <br />
                                        <small class="text-muted">کد پیگیری: @item.TrackingCode — @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                    </div>
                                    <span class="badge bg-warning text-dark">در انتظار بررسی</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- کارت ایجاد درخواست جدید -->
    <div class="card custom-card w-100">
        <div class="card-header">
            <div class="card-title mb-0">
                <i class="ri-file-add-line me-1"></i>
                ثبت درخواست جدید
            </div>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small mb-4">لطفا اطلاعات مورد نیاز را به صورت کامل وارد کنید.</p>

            <!-- نشانگر مراحل -->
            <div class="step-indicator">
                <div class="step-item active" data-step="1">
                    <div class="step-circle">۱</div>
                    <div class="step-label">اطلاعات متقاضی</div>
                </div>
                <div class="step-item" data-step="2">
                    <div class="step-circle">۲</div>
                    <div class="step-label">اطلاعات سند و قبض انبار</div>
                </div>
                <div class="step-item" data-step="3">
                    <div class="step-circle"><i class="ri-check-line"></i></div>
                    <div class="step-label">تکمیل ثبت</div>
                </div>
            </div>

            <form asp-action="ValidateSteps" method="post" id="needs-validation-form" autocomplete="off">
                @Html.AntiForgeryToken()

                <!-- مرحله ۱: اطلاعات متقاضی -->
                <div class="wizard-step active" data-step="1">
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <label for="MobileNumber" class="form-label text-default">شماره موبایل *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-smartphone-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="MobileNumber"
                                       name="MobileNumber"
                                       placeholder="مثال: 09123456789"
                                       maxlength="11"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="NationalCode" class="form-label text-default">کد ملی *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-id-card-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="NationalCode"
                                       name="NationalCode"
                                       placeholder="مثال: 1234567890"
                                       maxlength="10"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>
                    </div>

                    <!-- دکمه ارسال کد دو عاملی -->
                    <div class="mt-3">
                        <button type="button" id="btnSendOtp" class="btn btn-outline-primary btn-sm">
                            <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                        </button>
                        <span id="otpTimer" class="text-muted ms-2" style="display:none;"></span>
                    </div>

                    <!-- فیلد کد دو عاملی -->
                    <div class="row gy-3 mt-2" id="otpSection" style="display:none;">
                        <div class="col-md-6">
                            <label for="OtpCode" class="form-label text-default">کد تایید پیامک‌شده *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-shield-check-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="OtpCode"
                                       name="OtpCode"
                                       placeholder="کد ۶ رقمی را وارد کنید"
                                       maxlength="6"
                                       inputmode="numeric" />
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" id="btnVerifyOtp" class="btn btn-success btn-sm">
                                تایید کد
                            </button>
                        </div>
                    </div>

                    <div id="otpMessage" class="mt-2"></div>
                </div>

                <!-- مرحله ۲: اطلاعات سند و قبض انبار (بعد از تایید هویت، خودکار به این مرحله می‌رسیم) -->
                <div class="wizard-step" data-step="2">
                    <p class="fw-semibold mb-3 text-primary">
                        <i class="ri-file-text-line me-1"></i>
                        اطلاعات سند
                    </p>
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <label for="DocumentNumber" class="form-label text-default">شناسه سند *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-file-text-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="DocumentNumber"
                                       name="DocumentNumber"
                                       placeholder="شناسه ۱۸ رقمی سند"
                                       maxlength="18"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="VerifyCode" class="form-label text-default">رمز تصدیق *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-lock-password-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="VerifyCode"
                                       name="VerifyCode"
                                       placeholder="رمز تصدیق ۶ رقمی"
                                       maxlength="6"
                                       inputmode="numeric"
                                       required />
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <p class="fw-semibold mb-3 text-primary">
                        <i class="ri-archive-line me-1"></i>
                        اطلاعات قبض انبار
                    </p>
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <label for="CompanyId" class="form-label text-default">شرکت *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-building-2-line"></i></span>
                                <select class="form-select form-control-lg" id="CompanyId" name="CompanyId" required>
                                    <option value="">انتخاب شرکت</option>
                                    @foreach (var company in companies)
                                    {
                                        <option value="@company.CompanyId">@company.CompanyName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="WarehouseReceiptNumber" class="form-label text-default">شماره قبض انبار *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ri-archive-line"></i></span>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="WarehouseReceiptNumber"
                                       name="WarehouseReceiptNumber"
                                       placeholder="مثال: 987654321"
                                       required />
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-start gap-2 mt-4" role="alert">
                        <i class="ri-error-warning-line mt-1"></i>
                        <div>لطفا اطلاعات را به‌صورت صحیح وارد کنید. در صورت مغایرت اطلاعات، درخواست شما رد خواهد شد.</div>
                    </div>

                    <div class="wizard-nav">
                        <button type="button" class="btn btn-light btn-prev-step" data-step="2">قبلی</button>
                        <button type="submit" id="btnVerify" class="btn btn-primary">
                            <i class="ri-shield-check-line me-1"></i> احراز و ثبت درخواست
                        </button>
                    </div>
                </div>
            </form>

            <!-- مرحله ۳: تکمیل ثبت — بعد از ثبت موفق، به‌جای مودال همینجا نشون داده می‌شه -->
            <div class="wizard-step text-center py-4" data-step="3">
                <div class="mb-3">
                    <i class="ri-checkbox-circle-fill text-success" style="font-size:64px;"></i>
                </div>
                <h5 class="fw-bold mb-2">درخواست شما با موفقیت ثبت شد</h5>
                <p class="text-muted mb-3">درخواست شما به کارتابل کارشناسان مربوطه ارسال شد.</p>
                <p class="mb-2">کد پیگیری درخواست شما:</p>
                <div class="fs-3 fw-bold text-primary mb-3" id="trackingCodeValue" style="letter-spacing:1px;"></div>
                <p class="text-muted small mb-4">این کد به‌صورت پیامک هم برای شما ارسال می‌شود. برای پیگیری وضعیت درخواست، این کد را همراه با شماره موبایل خود در بخش «پیگیری درخواست» وارد کنید.</p>
                <button type="button" class="btn btn-primary" id="newRequestBtn">
                    <i class="ri-add-line me-1"></i> ثبت درخواست جدید
                </button>
            </div>

            <p class="text-muted small text-center mt-3 mb-0" id="termsNotice">
                با ثبت درخواست، <a href="#">قوانین و مقررات سامانه</a> را می‌پذیرم.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let otpVerified = false;
            let otpTimerInterval = null;
            let remainingSeconds = 0;

            // ===================== ویزارد مرحله‌ای =====================
            function showWizardStep(step) {
                $('.wizard-step').removeClass('active');
                $('.wizard-step[data-step="' + step + '"]').addClass('active');

                $('.step-item').removeClass('active completed');
                $('.step-item').each(function () {
                    const s = parseInt($(this).data('step'));
                    if (s < step) $(this).addClass('completed');
                    else if (s === step) $(this).addClass('active');
                });
            }

            $('.btn-prev-step').click(function () {
                showWizardStep(parseInt($(this).data('step')) - 1);
            });

            // ریست فرم (دکمه «پاک کردن فرم» یا بعد از ثبت موفق)
            $('#needs-validation-form').on('reset', function () {
                otpVerified = false;
                $('#otpSection').hide();
                $('#otpMessage').html('');
                $('#btnVerify').prop('disabled', true);
                $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', false).filter('#btnSendOtp').html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                clearInterval(otpTimerInterval);
                $('#otpTimer').hide();
                $('#termsNotice').show();
                showWizardStep(1);
            });

            // ارسال کد OTP
            $('#btnSendOtp').click(function () {
                const nationalCode = $('#NationalCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!nationalCode || nationalCode.length !== 10) {
                    window.showToast('کد ملی را به درستی وارد کنید', 'warning');
                    return;
                }
                if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                    window.showToast('شماره موبایل را به درستی وارد کنید', 'warning');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال بررسی احراز هویت...');

                // اول شاهکار چک می‌شه — اگه تطابق نداشت، اصلاً کد OTP ارسال نمی‌شه
                $.post('/Cartable/CheckShahkar', {
                    nationalCode: nationalCode,
                    mobileNumber: mobile
                })
                .done(function (checkRes) {
                    if (!checkRes.success) {
                        window.showToast(checkRes.message || 'خطا در احراز هویت', 'error');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }
                    if (!checkRes.isMatch) {
                        window.showToast('کد ملی و شماره موبایل تطابق ندارند', 'error');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }

                    btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال کد...');

                    $.post('/Cartable/SendOtp', {
                        nationalCode: nationalCode,
                        mobileNumber: mobile
                    })
                    .done(function (res) {
                        if (res.success) {
                            window.showToast(res.message || 'کد تایید ارسال شد', 'success');

                            if (res.debugOtp) {
                                window.showToast('کد تست: ' + res.debugOtp, 'info');
                            }

                            $('#otpSection').slideDown();
                            startOtpTimer(120);
                        } else {
                            window.showToast(res.message || 'خطا در ارسال کد', 'error');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                    })
                    .always(function () {
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                    });
                })
                .fail(function () {
                    window.showToast('خطا در ارتباط با سرور', 'error');
                    btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                });
            });

            // تایید کد OTP
            $('#btnVerifyOtp').click(function () {
                const otp = $('#OtpCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!otp || otp.length !== 6) {
                    window.showToast('کد ۶ رقمی را وارد کنید', 'warning');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', {
                    mobileNumber: mobile,
                    otpCode: otp
                })
                .done(function (res) {
                    if (res.success) {
                        otpVerified = true;
                        $('#otpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                        $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', true);
                        window.showToast('هویت شما تایید شد', 'success');
                        // احراز هویت تایید شد → خودکار به مرحله‌ی بعد (اطلاعات سند و قبض انبار) می‌ریم
                        showWizardStep(2);
                    } else {
                        $('#otpMessage').html('<small class="text-danger">' + (res.message || 'کد اشتباه است') + '</small>');
                        window.showToast(res.message || 'کد اشتباه است', 'error');
                        btn.prop('disabled', false).html('تایید کد');
                    }
                })
                .fail(function () {
                    window.showToast('خطا در ارتباط با سرور', 'error');
                    btn.prop('disabled', false).html('تایید کد');
                });
            });

            // تایمر OTP
            function startOtpTimer(seconds) {
                remainingSeconds = seconds;
                $('#otpTimer').show();
                clearInterval(otpTimerInterval);

                otpTimerInterval = setInterval(function () {
                    remainingSeconds--;
                    const min = Math.floor(remainingSeconds / 60);
                    const sec = remainingSeconds % 60;
                    $('#otpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (remainingSeconds <= 0) {
                        clearInterval(otpTimerInterval);
                        $('#otpTimer').hide();
                        $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال مجدد کد');
                    }
                }, 1000);
            }

            // «ثبت درخواست جدید» تو مرحله‌ی تکمیل — فرم رو واقعاً ریست می‌کنه و برمی‌گرده مرحله‌ی ۱
            $('#newRequestBtn').on('click', function () {
                $('#needs-validation-form')[0].reset();
            });

            // پیگیری درخواست — با کد پیگیری (مشخص، همچنان AJAX) یا فقط با موبایل+OTP.
            // مسیر دوم (لیست «در انتظار بررسی») دیگه با جاوااسکریپت رندر نمی‌شه — فرم به‌صورت GET معمولی
            // submit می‌شه و کنترلر (اکشن ClientIndex با پارامتر trackMobile) خودش لیست رو تو Razor رندر می‌کنه.
            let trackOtpTimerInterval = null;
            let trackRemainingSeconds = 0;

            function renderSingleTrackResult(res) {
                const badgeClass = res.status === 'تایید شده' ? 'bg-success' : (res.status === 'رد شده' ? 'bg-danger' : 'bg-warning text-dark');
                let html = '<div class="alert alert-light border">';
                html += '<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">';
                html += '<div><strong>' + res.trackingCode + '</strong><br><small class="text-muted">' + new Date(res.createdAt).toLocaleDateString('fa-IR') + '</small></div>';
                html += '<span class="badge ' + badgeClass + '">' + res.status + '</span>';
                html += '</div>';
                if (res.description) {
                    html += '<div class="mt-2 text-danger small">دلیل: ' + $('<div/>').text(res.description).html() + '</div>';
                }
                if (res.handlerName) {
                    html += '<div class="mt-2 small text-muted"><i class="ri-user-line me-1"></i> کارشناس مربوطه: ' + $('<div/>').text(res.handlerName).html();
                    if (res.handlerExtension) {
                        html += ' — داخلی: ' + $('<div/>').text(res.handlerExtension).html();
                    }
                    html += '</div>';
                }
                html += '</div>';
                $('#trackRequestResult').html(html);
            }

            $('#trackRequestForm').on('submit', function (e) {
                const trackingCode = $('#trackTrackingCode').val().trim();
                const mobileNumber = $('#trackMobileNumber').val().trim();

                if (!trackingCode) {
                    // کد پیگیری خالیه → بذار فرم به‌صورت معمولی (GET) submit بشه؛ سرور خودش تصمیم می‌گیره
                    // OTP رو بخواد یا لیست در انتظار رو نشون بده.
                    $('#trackRequestResult').empty();
                    return;
                }

                // مسیر مشخص: کد پیگیری + موبایل — بدون نیاز به OTP، صفحه رفرش نمی‌شه
                e.preventDefault();
                const resultBox = $('#trackRequestResult');
                $('#trackOtpSection').hide();
                resultBox.html('<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>');

                $.get('/Cartable/TrackRequest', { trackingCode: trackingCode, mobileNumber: mobileNumber })
                    .done(function (res) {
                        if (res && res.success) {
                            renderSingleTrackResult(res);
                        } else {
                            resultBox.html('<p class="text-danger text-center mb-0">' + ((res && res.message) || 'درخواستی یافت نشد.') + '</p>');
                        }
                    })
                    .fail(function (xhr) {
                        resultBox.html('<p class="text-danger text-center mb-0">' + (xhr.responseJSON?.message || 'خطا در پیگیری درخواست') + '</p>');
                    });
            });

            $('#trackBtnSendOtp').click(function () {
                const mobile = $('#trackMobileNumber').val().trim();
                if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                    window.showToast('شماره موبایل را به درستی وارد کنید', 'warning');
                    return;
                }
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

                $.post('/Cartable/SendOtp', { mobileNumber: mobile })
                    .done(function (res) {
                        if (res.success) {
                            window.showToast(res.message || 'کد تایید ارسال شد', 'success');
                            if (res.debugOtp) {
                                window.showToast('کد تست: ' + res.debugOtp, 'info');
                            }
                            startTrackOtpTimer(120);
                        } else {
                            window.showToast(res.message || 'خطا در ارسال کد', 'error');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                    })
                    .always(function () {
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                    });
            });

            $('#trackBtnVerifyOtp').click(function () {
                const mobile = $('#trackMobileNumber').val().trim();
                const otp = $('#trackOtpCode').val().trim();
                if (!otp || otp.length !== 6) {
                    window.showToast('کد ۶ رقمی را وارد کنید', 'warning');
                    return;
                }
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', { mobileNumber: mobile, otpCode: otp })
                    .done(function (res) {
                        if (res.success) {
                            $('#trackOtpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                            window.showToast('کد تایید صحیح است', 'success');
                            // OTP سمت سرور تایید شد؛ حالا صفحه رو با trackMobile رفرش می‌کنیم تا
                            // کنترلر خودش لیست درخواست‌های در انتظار رو (سمت سرور) رندر کنه.
                            window.location.href = '/Cartable/ClientIndex?trackMobile=' + encodeURIComponent(mobile);
                        } else {
                            window.showToast(res.message || 'کد اشتباه است', 'error');
                            btn.prop('disabled', false).html('تایید کد');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                        btn.prop('disabled', false).html('تایید کد');
                    });
            });

            function startTrackOtpTimer(seconds) {
                trackRemainingSeconds = seconds;
                $('#trackOtpTimer').show();
                clearInterval(trackOtpTimerInterval);

                trackOtpTimerInterval = setInterval(function () {
                    trackRemainingSeconds--;
                    const min = Math.floor(trackRemainingSeconds / 60);
                    const sec = trackRemainingSeconds % 60;
                    $('#trackOtpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (trackRemainingSeconds <= 0) {
                        clearInterval(trackOtpTimerInterval);
                        $('#trackOtpTimer').hide();
                    }
                }, 1000);
            }

            // فرم درخواست جدید
            $('#needs-validation-form').on('submit', function (e) {
                e.preventDefault();

                if (!otpVerified) {
                    window.showToast('لطفاً ابتدا کد تایید پیامکی را وارد و تایید کنید', 'warning');
                    return;
                }

                const btn = $('#btnVerify');
                if (!this.checkValidity()) {
                    window.showToast('لطفاً فیلدهای الزامی را پر کنید', 'error');
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done(function (data) {
                        if (data && data.success) {
                            const trackingCode = data.trackingCode;
                            btn.prop('disabled', false).html('<i class="ri-shield-check-line me-1"></i> احراز و ثبت درخواست');
                            if (trackingCode) {
                                // فرم عمداً اینجا reset نمی‌شه — تا کاربر «ثبت درخواست جدید» رو نزنه همینطور می‌مونه.
                                $('#trackingCodeValue').text(trackingCode);
                                $('#trackTrackingCode').val(trackingCode);
                                $('#termsNotice').hide();
                                showWizardStep(3);
                            } else {
                                window.showToast(data.message || 'درخواست با موفقیت ثبت شد', 'success');
                            }
                        } else {
                            window.showToast((data && data.message) || 'اطلاعات وارد شده معتبر نیست.', 'error');
                            btn.prop('disabled', false).html('<i class="ri-shield-check-line me-1"></i> احراز و ثبت درخواست');
                        }
                    })
                    .fail(function (xhr) {
                        window.showToast(xhr.responseJSON?.message || 'خطا در ارسال درخواست', 'error');
                        btn.prop('disabled', false).html('<i class="ri-shield-check-line me-1"></i> احراز و ثبت درخواست');
                    });
            });
        });
    </script>
}
