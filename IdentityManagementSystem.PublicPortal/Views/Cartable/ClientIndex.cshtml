@using IdentityManagementSystem.PublicPortal.Controllers
@{
    ViewData["Title"] = "ثبت درخواست";
    string? trackMobile = ViewBag.TrackMobile as string;
    bool trackOtpVerified = ViewBag.TrackOtpVerified is bool b && b;
    var pendingRequests = ViewBag.PendingRequests as List<PendingRequestItem>;
}


<!-- پیگیری درخواست با کد پیگیری + شماره موبایل (بدون نیاز به لاگین) -->
<div class="card custom-card mb-2 w-100" style="max-width: 100%;">
    <div class="card-header">
        <div class="card-title mb-0">
            <i class="ri-search-eye-line me-1"></i>
            پیگیری درخواست
        </div>
    </div>
    <div class="card-body">
        <form id="trackRequestForm" class="row g-3 align-items-end" method="get" asp-action="ClientIndex">
            <div class="col-md-4">
                <label for="trackTrackingCode" class="form-label text-default">کد پیگیری (اختیاری)</label>
                <input type="text" class="form-control" id="trackTrackingCode" placeholder="مثلاً REQ00020198" />
            </div>
            <div class="col-md-4">
                <label for="trackMobileNumber" class="form-label text-default">شماره موبایل</label>
                <input type="text" class="form-control" name="trackMobile" id="trackMobileNumber" value="@trackMobile" placeholder="مثلاً 09123456789" maxlength="11" inputmode="numeric" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">
                    <i class="ri-search-line me-1"></i> پیگیری وضعیت
                </button>
            </div>
        </form>

       

        <!-- فقط وقتی کد پیگیری خالیه و باید شماره موبایل با OTP تایید بشه نشون داده می‌شه -->
        <div id="trackOtpSection" class="row g-3 align-items-end mt-1" style="@(!string.IsNullOrEmpty(trackMobile) && !trackOtpVerified ? "" : "display:none;")">
            <div class="col-md-4">
                <button type="button" id="trackBtnSendOtp" class="btn btn-outline-primary btn-sm">
                    <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                </button>
                <span id="trackOtpTimer" class="text-muted ms-2" style="display:none;"></span>
            </div>
            <div class="col-md-4">
                <label for="trackOtpCode" class="form-label text-default">کد تایید پیامکی</label>
                <input type="text" class="form-control" id="trackOtpCode" placeholder="کد ۶ رقمی" maxlength="6" inputmode="numeric" />
            </div>
            <div class="col-md-4">
                <button type="button" id="trackBtnVerifyOtp" class="btn btn-success btn-sm">تایید کد</button>
            </div>
        </div>
        <div id="trackOtpMessage" class="mt-2"></div>

        <div id="trackRequestResult" class="mt-3"></div>

        @* --- نتیجه‌ی پیگیری با موبایل: کاملاً سمت کنترلر رندر می‌شه، نه با جاوااسکریپت --- *@
        @if (!string.IsNullOrEmpty(trackMobile) && trackOtpVerified)
        {
            <div class="mt-3">
                @if (pendingRequests == null || pendingRequests.Count == 0)
                {
                    <p class="text-muted text-center mb-0">درخواست «در انتظار بررسی»ای برای این شماره یافت نشد.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var item in pendingRequests)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    <strong>قبض انبار: @(string.IsNullOrEmpty(item.WarehouseReceiptNumber) ? "—" : item.WarehouseReceiptNumber)</strong>
                                    <br />
                                    <small class="text-muted">کد پیگیری: @item.TrackingCode — @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                                <span class="badge bg-warning text-dark">در انتظار بررسی</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- کارت ایجاد درخواست جدید -->
<div class="card custom-card w-100" style="max-width: 100%;">
    <div class="card-header">
        <div class="card-title mb-0">
            <i class="ri-file-add-line me-1"></i>
            ایجاد درخواست جدید
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="ValidateSteps" method="post" id="needs-validation-form" autocomplete="off">
            @Html.AntiForgeryToken()

            <!-- بخش اطلاعات متقاضی -->
            <div class="mb-4">
                <p class="fw-semibold mb-3 text-primary">
                    <i class="ri-user-line me-1"></i>
                    اطلاعات متقاضی
                </p>
                <div class="row gy-3">
                    <div class="col-md-6">
                        <label for="NationalCode" class="form-label text-default">کد ملی</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="NationalCode"
                               name="NationalCode"
                               placeholder="کد ملی ۱۰ رقمی"
                               maxlength="10"
                               inputmode="numeric"
                               required />
                    </div>
                    <div class="col-md-6">
                        <label for="MobileNumber" class="form-label text-default">شماره موبایل</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="MobileNumber"
                               name="MobileNumber"
                               placeholder="مثلاً 09123456789"
                               maxlength="11"
                               inputmode="numeric"
                               required />
                    </div>
                </div>

                <!-- دکمه ارسال کد دو عاملی -->
                <div class="mt-3">
                    <button type="button" id="btnSendOtp" class="btn btn-outline-primary btn-sm">
                        <i class="ri-message-2-line me-1"></i> ارسال کد تایید
                    </button>
                    <span id="otpTimer" class="text-muted ms-2" style="display:none;"></span>
                </div>

                <!-- فیلد کد دو عاملی -->
                <div class="row gy-3 mt-2" id="otpSection" style="display:none;">
                    <div class="col-md-6">
                        <label for="OtpCode" class="form-label text-default">کد تایید پیامکی</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="OtpCode"
                               name="OtpCode"
                               placeholder="کد ۶ رقمی"
                               maxlength="6"
                               inputmode="numeric" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="button" id="btnVerifyOtp" class="btn btn-success btn-sm">
                            تایید کد
                        </button>
                    </div>
                </div>

                <div id="otpMessage" class="mt-2"></div>
            </div>

            <hr class="my-4" />

            <!-- بخش اطلاعات سند -->
            <div class="mb-2">
                <p class="fw-semibold mb-3 text-primary">
                    <i class="ri-file-text-line me-1"></i>
                    اطلاعات سند
                </p>
                <div class="row gy-3">
                    <div class="col-md-6">
                        <label for="DocumentNumber" class="form-label text-default">شناسه سند</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="DocumentNumber"
                               name="DocumentNumber"
                               placeholder="شناسه سند را وارد کنید"
                               required />
                    </div>
                    <div class="col-md-6">
                        <label for="VerifyCode" class="form-label text-default">رمز تصدیق</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="VerifyCode"
                               name="VerifyCode"
                               placeholder="رمز تصدیق را وارد کنید"
                               required />
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- بخش قبض انبار -->
            <div class="mb-2">
                <p class="fw-semibold mb-3 text-primary">
                    <i class="ri-archive-line me-1"></i>
                    قبض انبار
                </p>
                <div class="row gy-3">
                    <div class="col-md-6">
                        <label for="WarehouseReceiptNumber" class="form-label text-default">شماره قبض انبار</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="WarehouseReceiptNumber"
                               name="WarehouseReceiptNumber"
                               placeholder="شماره قبض انبار را وارد کنید"
                               required />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="reset" class="btn btn-light">پاک کردن فرم</button>
                <button type="submit" id="btnVerify" class="btn btn-primary" disabled>
                    ثبت درخواست
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== مودال‌ها ==================== -->
<!-- مودال نمایش کد پیگیری بعد از ثبت موفق -->
<div class="modal fade" id="trackingCodeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ri-checkbox-circle-line text-success me-1"></i> درخواست شما ثبت شد</h5>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-2">کد پیگیری درخواست شما:</p>
                <div class="fs-3 fw-bold text-primary mb-2" id="trackingCodeValue" style="letter-spacing:1px;"></div>
                <small class="text-muted">این کد به‌صورت پیامک هم برای شما ارسال می‌شود. برای پیگیری وضعیت درخواست، این کد را همراه با شماره موبایل خود در بخش «پیگیری درخواست» وارد کنید.</small>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-primary" id="trackingCodeCloseBtn">متوجه شدم</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let otpVerified = false;
            let otpTimerInterval = null;
            let remainingSeconds = 0;

            // ریست فرم (دکمه «پاک کردن فرم» یا بعد از ثبت موفق)
            $('#needs-validation-form').on('reset', function () {
                otpVerified = false;
                $('#otpSection').hide();
                $('#otpMessage').html('');
                $('#btnVerify').prop('disabled', true);
                $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', false).filter('#btnSendOtp').html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                clearInterval(otpTimerInterval);
                $('#otpTimer').hide();
            });

            // ارسال کد OTP
            $('#btnSendOtp').click(function () {
                const nationalCode = $('#NationalCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!nationalCode || nationalCode.length !== 10) {
                    window.showToast('کد ملی را به درستی وارد کنید', 'warning');
                    return;
                }
                if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                    window.showToast('شماره موبایل را به درستی وارد کنید', 'warning');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال بررسی احراز هویت...');

                // اول شاهکار چک می‌شه — اگه تطابق نداشت، اصلاً کد OTP ارسال نمی‌شه
                $.post('/Cartable/CheckShahkar', {
                    nationalCode: nationalCode,
                    mobileNumber: mobile
                })
                .done(function (checkRes) {
                    if (!checkRes.success) {
                        window.showToast(checkRes.message || 'خطا در احراز هویت', 'error');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }
                    if (!checkRes.isMatch) {
                        window.showToast('کد ملی و شماره موبایل تطابق ندارند', 'error');
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                        return;
                    }

                    btn.html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال کد...');

                    $.post('/Cartable/SendOtp', {
                        nationalCode: nationalCode,
                        mobileNumber: mobile
                    })
                    .done(function (res) {
                        if (res.success) {
                            window.showToast(res.message || 'کد تایید ارسال شد', 'success');

                            if (res.debugOtp) {
                                window.showToast('کد تست: ' + res.debugOtp, 'info');
                            }

                            $('#otpSection').slideDown();
                            startOtpTimer(120);
                        } else {
                            window.showToast(res.message || 'خطا در ارسال کد', 'error');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                    })
                    .always(function () {
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                    });
                })
                .fail(function () {
                    window.showToast('خطا در ارتباط با سرور', 'error');
                    btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                });
            });

            // تایید کد OTP
            $('#btnVerifyOtp').click(function () {
                const otp = $('#OtpCode').val().trim();
                const mobile = $('#MobileNumber').val().trim();

                if (!otp || otp.length !== 6) {
                    window.showToast('کد ۶ رقمی را وارد کنید', 'warning');
                    return;
                }

                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', {
                    mobileNumber: mobile,
                    otpCode: otp
                })
                .done(function (res) {
                    if (res.success) {
                        otpVerified = true;
                        $('#otpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                        $('#btnVerify').prop('disabled', false);
                        $('#OtpCode, #btnVerifyOtp, #btnSendOtp').prop('disabled', true);
                        window.showToast('کد تایید صحیح است', 'success');
                    } else {
                        $('#otpMessage').html('<small class="text-danger">' + (res.message || 'کد اشتباه است') + '</small>');
                        window.showToast(res.message || 'کد اشتباه است', 'error');
                        btn.prop('disabled', false).html('تایید کد');
                    }
                })
                .fail(function () {
                    window.showToast('خطا در ارتباط با سرور', 'error');
                    btn.prop('disabled', false).html('تایید کد');
                });
            });

            // تایمر OTP
            function startOtpTimer(seconds) {
                remainingSeconds = seconds;
                $('#otpTimer').show();
                clearInterval(otpTimerInterval);

                otpTimerInterval = setInterval(function () {
                    remainingSeconds--;
                    const min = Math.floor(remainingSeconds / 60);
                    const sec = remainingSeconds % 60;
                    $('#otpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (remainingSeconds <= 0) {
                        clearInterval(otpTimerInterval);
                        $('#otpTimer').hide();
                        $('#btnSendOtp').prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال مجدد کد');
                    }
                }, 1000);
            }

            // بستن مودال کد پیگیری — صفحه رو رفرش می‌کنیم
            $('#trackingCodeCloseBtn').on('click', function () {
                $('#trackingCodeModal').modal('hide');
                location.reload();
            });

            // پیگیری درخواست — با کد پیگیری (مشخص، همچنان AJAX) یا فقط با موبایل+OTP.
            // مسیر دوم (لیست «در انتظار بررسی») دیگه با جاوااسکریپت رندر نمی‌شه — فرم به‌صورت GET معمولی
            // submit می‌شه و کنترلر (اکشن ClientIndex با پارامتر trackMobile) خودش لیست رو تو Razor رندر می‌کنه.
            let trackOtpTimerInterval = null;
            let trackRemainingSeconds = 0;

            function renderSingleTrackResult(res) {
                const badgeClass = res.status === 'تایید شده' ? 'bg-success' : (res.status === 'رد شده' ? 'bg-danger' : 'bg-warning text-dark');
                let html = '<div class="alert alert-light border">';
                html += '<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">';
                html += '<div><strong>' + res.trackingCode + '</strong><br><small class="text-muted">' + new Date(res.createdAt).toLocaleDateString('fa-IR') + '</small></div>';
                html += '<span class="badge ' + badgeClass + '">' + res.status + '</span>';
                html += '</div>';
                if (res.description) {
                    html += '<div class="mt-2 text-danger small">دلیل: ' + $('<div/>').text(res.description).html() + '</div>';
                }
                if (res.handlerName) {
                    html += '<div class="mt-2 small text-muted"><i class="ri-user-line me-1"></i> کارشناس مربوطه: ' + $('<div/>').text(res.handlerName).html();
                    if (res.handlerExtension) {
                        html += ' — داخلی: ' + $('<div/>').text(res.handlerExtension).html();
                    }
                    html += '</div>';
                }
                html += '</div>';
                $('#trackRequestResult').html(html);
            }

            $('#trackRequestForm').on('submit', function (e) {
                const trackingCode = $('#trackTrackingCode').val().trim();
                const mobileNumber = $('#trackMobileNumber').val().trim();

                if (!trackingCode) {
                    // کد پیگیری خالیه → بذار فرم به‌صورت معمولی (GET) submit بشه؛ سرور خودش تصمیم می‌گیره
                    // OTP رو بخواد یا لیست در انتظار رو نشون بده.
                    $('#trackRequestResult').empty();
                    return;
                }

                // مسیر مشخص: کد پیگیری + موبایل — بدون نیاز به OTP، صفحه رفرش نمی‌شه
                e.preventDefault();
                const resultBox = $('#trackRequestResult');
                $('#trackOtpSection').hide();
                resultBox.html('<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>');

                $.get('/Cartable/TrackRequest', { trackingCode: trackingCode, mobileNumber: mobileNumber })
                    .done(function (res) {
                        if (res && res.success) {
                            renderSingleTrackResult(res);
                        } else {
                            resultBox.html('<p class="text-danger text-center mb-0">' + ((res && res.message) || 'درخواستی یافت نشد.') + '</p>');
                        }
                    })
                    .fail(function (xhr) {
                        resultBox.html('<p class="text-danger text-center mb-0">' + (xhr.responseJSON?.message || 'خطا در پیگیری درخواست') + '</p>');
                    });
            });

            $('#trackBtnSendOtp').click(function () {
                const mobile = $('#trackMobileNumber').val().trim();
                if (!mobile || mobile.length !== 11 || !mobile.startsWith('09')) {
                    window.showToast('شماره موبایل را به درستی وارد کنید', 'warning');
                    return;
                }
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

                $.post('/Cartable/SendOtp', { mobileNumber: mobile })
                    .done(function (res) {
                        if (res.success) {
                            window.showToast(res.message || 'کد تایید ارسال شد', 'success');
                            if (res.debugOtp) {
                                window.showToast('کد تست: ' + res.debugOtp, 'info');
                            }
                            startTrackOtpTimer(120);
                        } else {
                            window.showToast(res.message || 'خطا در ارسال کد', 'error');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                    })
                    .always(function () {
                        btn.prop('disabled', false).html('<i class="ri-message-2-line me-1"></i> ارسال کد تایید');
                    });
            });

            $('#trackBtnVerifyOtp').click(function () {
                const mobile = $('#trackMobileNumber').val().trim();
                const otp = $('#trackOtpCode').val().trim();
                if (!otp || otp.length !== 6) {
                    window.showToast('کد ۶ رقمی را وارد کنید', 'warning');
                    return;
                }
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.post('/Cartable/VerifyOtp', { mobileNumber: mobile, otpCode: otp })
                    .done(function (res) {
                        if (res.success) {
                            $('#trackOtpMessage').html('<small class="text-success"><i class="ri-check-line"></i> شماره موبایل تایید شد</small>');
                            window.showToast('کد تایید صحیح است', 'success');
                            // OTP سمت سرور تایید شد؛ حالا صفحه رو با trackMobile رفرش می‌کنیم تا
                            // کنترلر خودش لیست درخواست‌های در انتظار رو (سمت سرور) رندر کنه.
                            window.location.href = '/Cartable/ClientIndex?trackMobile=' + encodeURIComponent(mobile);
                        } else {
                            window.showToast(res.message || 'کد اشتباه است', 'error');
                            btn.prop('disabled', false).html('تایید کد');
                        }
                    })
                    .fail(function () {
                        window.showToast('خطا در ارتباط با سرور', 'error');
                        btn.prop('disabled', false).html('تایید کد');
                    });
            });

            function startTrackOtpTimer(seconds) {
                trackRemainingSeconds = seconds;
                $('#trackOtpTimer').show();
                clearInterval(trackOtpTimerInterval);

                trackOtpTimerInterval = setInterval(function () {
                    trackRemainingSeconds--;
                    const min = Math.floor(trackRemainingSeconds / 60);
                    const sec = trackRemainingSeconds % 60;
                    $('#trackOtpTimer').text(`ارسال مجدد تا ${min}:${sec.toString().padStart(2, '0')}`);

                    if (trackRemainingSeconds <= 0) {
                        clearInterval(trackOtpTimerInterval);
                        $('#trackOtpTimer').hide();
                    }
                }, 1000);
            }

            // فرم درخواست جدید
            $('#needs-validation-form').on('submit', function (e) {
                e.preventDefault();

                if (!otpVerified) {
                    window.showToast('لطفاً ابتدا کد تایید پیامکی را وارد و تایید کنید', 'warning');
                    return;
                }

                const btn = $('#btnVerify');
                if (!this.checkValidity()) {
                    window.showToast('لطفاً فیلدهای الزامی را پر کنید', 'error');
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done(function (data) {
                        if (data && data.success) {
                            const trackingCode = data.trackingCode;
                            $('#needs-validation-form')[0].reset();
                            // فرم ریست شد یعنی تایید OTP هم پاک شد؛ دکمه عمداً غیرفعال می‌مونه تا درخواست بعدی دوباره تایید بشه
                            btn.html('ثبت درخواست');
                            if (trackingCode) {
                                $('#trackingCodeValue').text(trackingCode);
                                $('#trackTrackingCode').val(trackingCode);
                                $('#trackingCodeModal').modal('show');
                            } else {
                                window.showToast(data.message || 'درخواست با موفقیت ثبت شد', 'success');
                            }
                        } else {
                            window.showToast((data && data.message) || 'اطلاعات وارد شده معتبر نیست.', 'error');
                            btn.prop('disabled', false).html('ثبت درخواست');
                        }
                    })
                    .fail(function (xhr) {
                        window.showToast(xhr.responseJSON?.message || 'خطا در ارسال درخواست', 'error');
                        btn.prop('disabled', false).html('ثبت درخواست');
                    });
            });
        });
    </script>
}
