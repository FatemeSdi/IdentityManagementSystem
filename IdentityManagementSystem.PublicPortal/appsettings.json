{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    // ApiKey (و PublicPortal:Username/Password) تو appsettings.Secrets.json (خارج از گیت) هستن؛ ساختارش: appsettings.Secrets.example.json
    // حالت ارتباط با API (بدون restart قابل تغییره):
    //   Pomix         = از طریق Gateway سازمان؛ آدرس هر سه هندلر از PomixUrls
    //   DirectGateway = مستقیم به سرور API ولی فقط از سه هندلر ({URL}/api/{handler})
    //   DirectApi     = مستقیم به همه‌ی اندپوینت‌ها ({URL}/api/...) — فقط برای عیب‌یابی؛ تو Production سمت API بسته‌ست
    "Mode": "DirectGateway",
    // آدرس مستقیم سرور API (برای DirectGateway و DirectApi)
    "URL": "http://localhost:5066",
    // آدرس سه هندلر روی Gateway سازمان (برای Pomix)
    "PomixUrls": {
      "auth-handler": "",
      "ehraz-handler": "",
      "service-handler": ""
    }
  }
}
